---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Icon from '../../components/ui/Icon.astro';
import { OFFICIAL_HOTLINES } from '../../data/contactInfo';
---

<BaseLayout
  title="Emergency Information | Togh Aman"
  description="Immediate emergency contacts for police, rescue 1122, medical facilities, and the Togh Aman Committee emergency hotline."
>
  <section class="page-header emergency-header">
    <div class="container text-center">
      <Badge variant="danger">Immediate Assistance</Badge>
      <h1 class="page-title text-danger">Emergency Information & Contacts</h1>
      <p class="page-subtitle">
        In life-threatening situations, crimes in progress, or disasters, call official government emergency services first.
      </p>
      <div class="mt-4">
        <button type="button" class="btn-primary print-btn" onclick="window.print()">
          <Icon name="document" size={16} />
          <span>Print Emergency Directory</span>
        </button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="emergency-grid">
        <!-- Official Law Enforcement & Rescue -->
        <div class="card card-emergency">
          <span class="emergency-tag">National Hotlines</span>
          <h3>Government First Responders</h3>
          <div class="emergency-contacts-list">
            <div class="e-contact-item">
              <div>
                <strong>Police Emergency Service</strong>
                <span>Dial immediately for ongoing crimes or violence</span>
              </div>
              <a href="tel:15" class="e-number-pill">15</a>
            </div>

            <div class="e-contact-item">
              <div>
                <strong>Rescue & Medical Emergency (Ambulance / Fire)</strong>
                <span>Rapid paramedic & disaster response team</span>
              </div>
              <a href="tel:1122" class="e-number-pill">1122</a>
            </div>

            <div class="e-contact-item">
              <div>
                <strong>Edhi Ambulance Service</strong>
                <span>Countrywide ambulance assistance</span>
              </div>
              <a href="tel:115" class="e-number-pill">115</a>
            </div>

            <div class="e-contact-item">
              <div>
                <strong>District Police Officer (DPO) Kohat</strong>
                <span>District police supervision & public control room</span>
              </div>
              <a href="tel:09229260022" class="e-number-pill">0922-9260022</a>
            </div>
          </div>
        </div>

        <!-- Committee Emergency Hotline -->
        <div class="card card-gold-accent">
          <span class="emergency-tag tag-gold">Local Coordination</span>
          <h3>Committee Rapid Assistance</h3>
          <p class="committee-e-desc">
            For urgent community disputes, disaster coordination, or mediation that requires executive committee presence:
          </p>

          <div class="committee-emergency-list">
            {OFFICIAL_HOTLINES.map((h, idx) => (
              <div class="committee-emergency-box">
                <Icon name="phone" size={24} class="text-gold" />
                <div class="emergency-box-main">
                  <span class="box-label">Line 0{idx + 1}: {h.label}</span>
                  <a href={`tel:${h.raw}`} class="box-number">{h.phone}</a>
                  <span class="box-sub">Voice Call &amp; WhatsApp Live</span>
                </div>
                <div class="emergency-box-actions">
                  <a href={`tel:${h.raw}`} class="btn-e-action btn-e-call" title={`Call ${h.phone}`}>
                    <Icon name="phone" size={14} />
                    <span>Call</span>
                  </a>
                  <a href={h.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-e-action btn-e-wa" title={`WhatsApp ${h.phone}`}>
                    <Icon name="whatsapp" size={14} />
                    <span>WhatsApp</span>
                  </a>
                </div>
              </div>
            ))}
          </div>

          <div class="emergency-policy-notice">
            <Icon name="shield" size={18} class="text-green" />
            <p>
              <strong>Constitutional Rule (Part 2 Policy):</strong> The committee volunteer corps does not take the law into its own hands. 
              In case of fire, flood, or accident, the committee coordinates with district departments and mobilizes local volunteers.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(180deg, var(--color-danger-bg) 0%, var(--color-background) 100%);
    padding: var(--space-12) 0;
    border-bottom: 1px solid var(--color-danger-border);
  }

  .text-danger {
    color: var(--color-danger);
  }

  .page-title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 680px;
    margin: 0 auto;
  }

  .print-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .emergency-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 992px) {
    .emergency-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .card-emergency {
    border-top: 4px solid var(--color-danger);
    padding: var(--space-8);
  }

  .emergency-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-danger);
    display: block;
    margin-bottom: var(--space-2);
  }

  .tag-gold {
    color: var(--color-gold);
  }

  .emergency-contacts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .e-contact-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .e-contact-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .e-contact-item strong {
    font-size: var(--text-base);
    color: var(--color-text);
    display: block;
    margin-bottom: 2px;
  }

  .e-contact-item span {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .e-number-pill {
    background: var(--color-danger-bg);
    color: var(--color-danger);
    border: 2px solid var(--color-danger-border);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: var(--text-lg);
    text-decoration: none;
    flex-shrink: 0;
    transition: all var(--duration-fast);
  }

  .e-number-pill:hover {
    background: var(--color-danger);
    color: var(--color-white);
  }

  .committee-e-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .committee-emergency-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .committee-emergency-box {
    background: var(--color-surface-subtle);
    border: 1px solid rgba(212, 160, 23, 0.4);
    border-left: 4px solid var(--color-gold);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .emergency-box-main {
    flex: 1;
  }

  .box-label {
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-primary);
    display: block;
    margin-bottom: 2px;
  }

  .box-number {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-gold-dark);
    text-decoration: none;
    display: block;
    line-height: 1.2;
  }

  .box-number:hover {
    color: var(--color-green);
  }

  .box-sub {
    font-size: 11px;
    color: var(--color-text-subtle);
  }

  .emergency-box-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .btn-e-action {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--duration-fast);
  }

  .btn-e-call {
    background: #FFFFFF;
    color: var(--color-primary);
    border: 1px solid var(--color-border);
  }

  .btn-e-call:hover {
    background: var(--color-primary);
    color: #FFFFFF;
  }

  .btn-e-wa {
    background: #E8F5E9;
    color: #1B5E20;
    border: 1px solid rgba(37, 211, 102, 0.4);
  }

  .btn-e-wa:hover {
    background: #25D366;
    color: #FFFFFF;
    border-color: #25D366;
  }

  @media (max-width: 576px) {
    .committee-emergency-box {
      flex-direction: column;
      align-items: flex-start;
    }
    .emergency-box-actions {
      width: 100%;
    }
    .btn-e-action {
      flex: 1;
      justify-content: center;
    }
  }

  .emergency-policy-notice {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4);
    background: rgba(8, 116, 67, 0.05);
    border-radius: var(--radius-md);
  }

  .emergency-policy-notice p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .text-center { text-align: center; }
  .text-gold { color: var(--color-gold); }
  .text-green { color: var(--color-green); }
  .mt-4 { margin-top: var(--space-4); }
</style>
