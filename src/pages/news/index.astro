---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import NewsCard from '../../components/blocks/NewsCard.astro';

const allNews = await getCollection('news');
const sortedNews = allNews.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Official Announcements & News | Togh Aman"
  description="Read verified official press releases, event notices, opening announcements, and statements from Togh Aman Committee."
>
  <section class="page-header">
    <div class="container text-center">
      <Badge variant="gold">Media & Communications</Badge>
      <h1 class="page-title">Announcements & News</h1>
      <p class="page-subtitle">
        Official statements, executive addresses, and verified community news from Togh Bala & Payan.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="news-list-grid">
        {sortedNews.map((n) => (
          <NewsCard
            slug={n.id}
            title={n.data.title}
            description={n.data.description}
            pubDate={n.data.pubDate}
            category={n.data.category}
            image={n.data.image}
            pinned={n.data.pinned}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(180deg, var(--color-surface-subtle) 0%, var(--color-background) 100%);
    padding: var(--space-12) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .page-title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 640px;
    margin: 0 auto;
  }

  .news-list-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .news-list-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .news-list-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .text-center { text-align: center; }
</style>
