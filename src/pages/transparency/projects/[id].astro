---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import Icon from '../../../components/ui/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({
    params: { id: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const statusVariant = project.data.status === 'Completed' 
  ? 'success' 
  : project.data.status === 'In Progress' 
    ? 'green' 
    : 'gold';
---

<BaseLayout
  title={`${project.data.title.substring(0, 40)} | Togh Projects`}
  description={`Community development project: ${project.data.title}. Linked to Resolution #${project.data.resolutionNo}.`}
>
  <div class="container section">
    <div class="project-detail-wrap">
      <div class="card card-gold-accent project-detail-card">
        <div class="proj-header-badges">
          <Badge variant="gold">Resolution #{project.data.resolutionNo}</Badge>
          <Badge variant={statusVariant}>{project.data.status}</Badge>
          {project.data.isSample && <Badge variant="neutral">SAMPLE PROJECT</Badge>}
        </div>

        <h1 class="project-full-title">{project.data.title}</h1>

        <div class="project-stats-banner">
          <div class="stat-pill">
            <span class="p-label">Budget Allocated</span>
            <strong class="p-val">{project.data.budget}</strong>
          </div>
          <div class="stat-pill">
            <span class="p-label">Current Progress</span>
            <strong class="p-val text-green">{project.data.progress}%</strong>
          </div>
          <div class="stat-pill">
            <span class="p-label">Execution Timeline</span>
            <strong class="p-val">{project.data.timeline}</strong>
          </div>
          <div class="stat-pill">
            <span class="p-label">Responsible Wing</span>
            <strong class="p-val">{project.data.responsible}</strong>
          </div>
        </div>

        <!-- Problem & Proposal Box -->
        <div class="problem-proposal-grid">
          <div class="pp-card">
            <h3>Civic Problem</h3>
            <p>{project.data.problem}</p>
          </div>
          <div class="pp-card">
            <h3>Approved Proposal</h3>
            <p>{project.data.proposal}</p>
          </div>
        </div>

        <!-- Milestone Execution Flow -->
        <div class="milestones-section">
          <h3>Constitutional Milestone Stages (Chapter 14)</h3>
          <div class="milestones-list">
            {project.data.stages.map((stage, idx) => (
              <div class={`milestone-item stage-${stage.status}`}>
                <div class="m-step">{idx + 1}</div>
                <div class="m-info">
                  <strong>{stage.name}</strong>
                  <span class="m-status-text">
                    Status: {stage.status === 'completed' ? 'Verified Completed' : stage.status === 'in-progress' ? 'Active In Progress' : 'Pending Commencement'}
                  </span>
                </div>
                {stage.status === 'completed' && <Icon name="check" size={18} class="text-green m-check" />}
              </div>
            ))}
          </div>
        </div>

        <!-- Completion Report Box -->
        {project.data.completionReport && (
          <div class="completion-report-box">
            <div class="cr-top">
              <Icon name="document" size={24} class="text-green" />
              <div>
                <strong>Official Completion & Audit Note</strong>
                <p>{project.data.completionReport}</p>
              </div>
            </div>
          </div>
        )}

        <!-- Markdown Body (Execution Details) -->
        <div class="project-body-prose">
          <Content />
        </div>

        <div class="project-detail-footer">
          <Button variant="outline" size="sm" href="/transparency/projects">
            <Icon name="arrow-right" size={14} class="rotate-180" />
            <span>Back to Projects Tracker</span>
          </Button>

          <Button variant="primary" size="sm" href="/transparency/finances">
            <span>View Financial Ledgers</span>
            <Icon name="arrow-right" size={14} />
          </Button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .project-detail-wrap {
    max-width: 900px;
    margin: 0 auto;
  }

  .project-detail-card {
    padding: var(--space-8);
  }

  .proj-header-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .project-full-title {
    font-size: var(--text-3xl);
    color: var(--color-primary);
    margin-bottom: var(--space-6);
    line-height: var(--leading-tight);
  }

  .project-stats-banner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .project-stats-banner {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-pill {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .p-label {
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-text-subtle);
  }

  .p-val {
    font-size: var(--text-base);
    color: var(--color-primary);
  }

  .text-green { color: var(--color-green); }

  .problem-proposal-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .problem-proposal-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pp-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    border-top: 3px solid var(--color-green);
  }

  .pp-card h3 {
    font-size: var(--text-lg);
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .pp-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin-bottom: 0;
  }

  .milestones-section {
    margin-bottom: var(--space-8);
  }

  .milestones-section h3 {
    font-size: var(--text-xl);
    color: var(--color-primary);
    margin-bottom: var(--space-4);
  }

  .milestones-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .milestone-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .stage-completed {
    background: var(--color-success-bg);
    border-color: var(--color-success-border);
  }

  .stage-in-progress {
    background: var(--color-gold-soft);
    border-color: var(--color-gold-border);
  }

  .stage-pending {
    background: var(--color-surface-subtle);
    opacity: 0.7;
  }

  .m-step {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: var(--text-xs);
    flex-shrink: 0;
  }

  .m-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .m-info strong {
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .m-status-text {
    font-size: 11px;
    color: var(--color-text-subtle);
  }

  .m-check {
    margin-left: auto;
  }

  .completion-report-box {
    background: rgba(8, 116, 67, 0.08);
    border: 1px solid rgba(8, 116, 67, 0.25);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .cr-top {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .cr-top strong {
    color: var(--color-primary);
    font-size: var(--text-sm);
    display: block;
    margin-bottom: 2px;
  }

  .cr-top p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .project-body-prose {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
  }

  .project-body-prose :global(h3) {
    color: var(--color-primary);
    font-size: var(--text-base);
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .project-detail-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .rotate-180 {
    transform: rotate(180deg);
  }
</style>
