---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import Icon from '../../../components/ui/Icon.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => b.data.progress - a.data.progress);
---

<BaseLayout
  title="Projects Progress Tracker | Togh Aman"
  description="Track real-time community development projects in Togh. Problem, Proposal, Resolution, Budget, Timeline, and verified completion reports."
>
  <section class="page-header">
    <div class="container text-center">
      <Badge variant="gold">Chapter 14 Mandate</Badge>
      <h1 class="page-title">Community Projects Tracker</h1>
      <p class="page-subtitle">
        "Problem &rarr; Proposal &rarr; Resolution &rarr; Responsible Person &rarr; Budget &rarr; Timeline &rarr; Progress &rarr; Completion Report."
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="projects-list">
        {sortedProjects.map((p) => {
          const statusVariant = p.data.status === 'Completed' 
            ? 'success' 
            : p.data.status === 'In Progress' 
              ? 'green' 
              : 'gold';

          return (
            <article class="project-tracker-card card reveal-on-scroll">
              <div class="proj-top-bar">
                <div class="proj-badges">
                  <span class="res-link-badge">
                    <Icon name="document" size={14} />
                    <span>Under Resolution #{p.data.resolutionNo}</span>
                  </span>
                  <Badge variant={statusVariant} size="sm">{p.data.status}</Badge>
                  {p.data.isSample && <Badge variant="neutral" size="sm">SAMPLE</Badge>}
                </div>
                <span class="proj-budget">Budget: <strong>{p.data.budget}</strong></span>
              </div>

              <h2 class="proj-title">
                <a href={`/transparency/projects/${p.id}`}>{p.data.title}</a>
              </h2>

              <p class="proj-problem">
                <strong>Civic Problem:</strong> {p.data.problem}
              </p>

              <!-- Progress Bar -->
              <div class="progress-wrap">
                <div class="progress-info">
                  <span class="progress-label">Current Execution Progress</span>
                  <strong class="progress-percentage">{p.data.progress}%</strong>
                </div>
                <div class="progress-track" role="progressbar" aria-valuenow={p.data.progress} aria-valuemin="0" aria-valuemax="100">
                  <div class="progress-fill" style={`width: ${p.data.progress}%;`}></div>
                </div>
              </div>

              <!-- Milestone Stages Grid -->
              <div class="stages-flow-grid">
                {p.data.stages.map((stage, idx) => (
                  <div class={`stage-pill stage-${stage.status}`}>
                    <span class="stage-step-num">{idx + 1}</span>
                    <span class="stage-step-name">{stage.name}</span>
                  </div>
                ))}
              </div>

              <div class="proj-footer">
                <div class="proj-footer-info">
                  <span><strong>Responsible:</strong> {p.data.responsible}</span> &bull; 
                  <span><strong>Timeline:</strong> {p.data.timeline}</span>
                </div>
                <Button variant="outline" size="sm" href={`/transparency/projects/${p.id}`}>
                  <span>Project Dossier</span>
                  <Icon name="arrow-right" size={12} />
                </Button>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(180deg, var(--color-surface-subtle) 0%, var(--color-background) 100%);
    padding: var(--space-12) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .page-title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 680px;
    margin: 0 auto;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .project-tracker-card {
    padding: var(--space-8);
    border-top: 4px solid var(--color-gold);
  }

  .proj-top-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .proj-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .res-link-badge {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .proj-budget {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .proj-budget strong {
    color: var(--color-primary);
  }

  .proj-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }

  .proj-title a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .proj-title a:hover {
    color: var(--color-gold);
  }

  .proj-problem {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-6);
  }

  /* Progress Bar */
  .progress-wrap {
    margin-bottom: var(--space-6);
    background: var(--color-surface-subtle);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .progress-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .progress-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .progress-percentage {
    font-size: var(--text-base);
    color: var(--color-green);
    font-weight: 800;
    font-family: monospace;
  }

  .progress-track {
    width: 100%;
    height: 10px;
    background: var(--color-border);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-green) 0%, var(--color-gold) 100%);
    border-radius: var(--radius-full);
    transition: width 0.8s var(--ease-spring);
  }

  /* Stages Grid */
  .stages-flow-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .stages-flow-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .stages-flow-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stage-pill {
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 11px;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--color-border);
  }

  .stage-completed {
    background: var(--color-success-bg);
    color: var(--color-success);
    border-color: var(--color-success-border);
    font-weight: 600;
  }

  .stage-in-progress {
    background: var(--color-gold-soft);
    color: var(--color-gold-dark);
    border-color: var(--color-gold-border);
    font-weight: 700;
  }

  .stage-pending {
    background: var(--color-surface-subtle);
    color: var(--color-text-subtle);
  }

  .stage-step-num {
    font-weight: 800;
    font-size: 10px;
    border-radius: var(--radius-full);
    width: 16px;
    height: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.08);
  }

  .proj-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .proj-footer-info {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .text-center { text-align: center; }
</style>
