    border-radius: 4px;
    margin-bottom: 6px;
  }

  .amend-step strong {
    display: block;
    font-size: 13.5px;
    color: var(--color-primary);
    margin-bottom: 4px;
  }

  .amend-step p {
    font-size: 12px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.45;
  }

  /* Part 2: Policy Table */
  .policy-table-wrapper {
    overflow-x: auto;
    margin-top: var(--space-4);
  }

  .policy-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
  }

  .policy-table th {
    background: var(--color-primary);
    color: #FFFFFF;
    padding: 12px 14px;
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 0.03em;
  }

  .policy-table td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    line-height: 1.5;
  }

  .policy-table tbody tr:nth-child(even) {
    background: var(--color-surface-subtle);
  }

  .policy-table tbody tr:hover {
    background: rgba(6, 77, 50, 0.04);
  }

  /* Foundational Principle Oath Banner */
  .principle-banner {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    color: var(--color-white);
    text-align: center;
    border-top: 5px solid var(--color-gold);
    padding: var(--space-10) var(--space-8);
  }

  .banner-crest {
    margin-bottom: var(--space-2);
  }

  .banner-subtitle {
    display: block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    margin-bottom: var(--space-2);
  }

  .principle-banner h2 {
    color: #FFFFFF;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-bottom: var(--space-2);
  }

  .urdu-banner-quote {
    display: block;
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    font-weight: 700;
    color: var(--color-gold);
    margin-bottom: var(--space-4);
    line-height: 1.8;
  }

  .oath-quote {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-style: italic;
    color: rgba(255, 255, 255, 0.95);
    margin: 0 auto var(--space-4);
    max-width: 760px;
    line-height: 1.5;
  }

  .banner-lead {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
    max-width: 820px;
    margin: 0 auto var(--space-8);
    line-height: 1.6;
  }

  .banner-signatories {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .signatory-card {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .signatory-card strong {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold);
  }

  .signatory-card span {
    font-size: 17px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 2px 0;
  }

  .signatory-card small {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
  }

  .signatory-divider {
    width: 1px;
    height: 40px;
    background: rgba(255, 255, 255, 0.2);
  }

  /* Footer Related Registers CTA */
  .doc-footer-cta {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    padding: var(--space-8);
    border-radius: var(--radius-md);
  }

  .doc-footer-cta h3 {
    font-size: 20px;
    color: var(--color-primary);
    margin-bottom: 4px;
  }

  .doc-footer-cta p {
    font-size: 14px;
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .footer-cta-buttons {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* Floating Back to Top Button */
  .floating-back-to-top {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: var(--color-primary);
    color: #FFFFFF;
    border: 2px solid var(--color-gold);
    border-radius: 9999px;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
    cursor: pointer;
    z-index: 99;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: all var(--duration-fast);
  }

  .floating-back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .floating-back-to-top:hover {
    background: var(--color-primary-dark);
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }

  /* Typography Sizing Adjustments (Accessibility) */
  body.font-size-sm .doc-content {
    font-size: 13.5px;
  }
  body.font-size-lg .doc-content {
    font-size: 17.5px;
  }
  body.font-size-lg .doc-section h2 {
    font-size: 2.1rem;
  }
  body.font-size-lg .article-block p, 
  body.font-size-lg .styled-doc-list, 
  body.font-size-lg .policy-table td {
    font-size: 15.5px;
  }

  /* Print Stylesheet */
  @media print {
    .doc-hero-section,
    .doc-utility-bar,
    .toc-sidebar,
    .floating-back-to-top,
    .doc-footer-cta,
    .interactive-tool-box {
      display: none !important;
    }

    body {
      background: #FFFFFF !important;
      color: #000000 !important;
    }

    .doc-layout-container {
      padding: 0 !important;
      display: block !important;
    }

    .doc-content {
      display: block !important;
    }

    .doc-section {
      box-shadow: none !important;
      border: 1px solid #CCC !important;
      page-break-inside: avoid;
      margin-bottom: 24px !important;
      padding: 16px !important;
    }

    .principle-banner {
      background: #EEEEEE !important;
      color: #000000 !important;
      border: 2px solid #000 !important;
    }

    .principle-banner h2, .urdu-banner-quote, .signatory-card span {
      color: #000000 !important;
    }
  }
</style>

<script>
  function setupConstitutionInteractivity() {
    // 1. Hero Ambient Mouse Spotlight Glow Tracker
    const heroSection = document.getElementById('doc-hero');
    if (heroSection) {
      heroSection.addEventListener('mousemove', (e) => {
        const rect = heroSection.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        heroSection.style.setProperty('--mouse-x', `${x}%`);
        heroSection.style.setProperty('--mouse-y', `${y}%`);
      });
    }

    // 2. Interactive Quorum Calculator
    const quorumSlider = document.getElementById('quorum-slider') as HTMLInputElement | null;
    const quorumCountDisplay = document.getElementById('quorum-count-display');
    const quorumResultBox = document.getElementById('quorum-result-box');
    const quorumVerdictTitle = document.getElementById('quorum-verdict-title');
    const quorumVerdictDesc = document.getElementById('quorum-verdict-desc');

    if (quorumSlider && quorumCountDisplay && quorumResultBox && quorumVerdictTitle && quorumVerdictDesc) {
      const updateQuorum = () => {
        const count = parseInt(quorumSlider.value, 10);
        const total = 21;
        const percentage = ((count / total) * 100).toFixed(1);
        quorumCountDisplay.textContent = `${count} / ${total} Members (${percentage}%)`;

        if (count >= 11) {
          quorumResultBox.className = 'quorum-status-card status-valid';
          quorumVerdictTitle.textContent = 'QUORUM ACHIEVED — MEETING LEGALLY VALID';
          quorumVerdictDesc.textContent = `${count} of ${total} members present (${percentage}%). The statutory threshold of 50%+1 (11 members) is satisfied. Binding resolutions may be formally enacted.`;
        } else {
          quorumResultBox.className = 'quorum-status-card status-invalid';
          quorumVerdictTitle.textContent = 'QUORUM FAILED — DECISIONS NULL & VOID';
          quorumVerdictDesc.textContent = `Only ${count} of ${total} members present (${percentage}%). Under Chapter 6, Article 6.5, a minimum of 11 members (50%+1) is required. Any votes taken will be constitutionally invalid.`;
        }
      };

      quorumSlider.addEventListener('input', updateQuorum);
      updateQuorum();
    }

    // 3. Print / Save as PDF Button
    const printBtn = document.getElementById('btn-print-constitution');
    printBtn?.addEventListener('click', () => {
      window.print();
    });

    // 4. Font Size Switcher
    const fontDecrease = document.getElementById('font-decrease');
    const fontNormal = document.getElementById('font-normal');
    const fontIncrease = document.getElementById('font-increase');
    const fontButtons = [fontDecrease, fontNormal, fontIncrease];

    const setFontSize = (size: 'sm' | 'base' | 'lg') => {
      document.body.classList.remove('font-size-sm', 'font-size-lg');
      fontButtons.forEach(b => b?.classList.remove('active'));

      if (size === 'sm') {
        document.body.classList.add('font-size-sm');
        fontDecrease?.classList.add('active');
      } else if (size === 'lg') {
        document.body.classList.add('font-size-lg');
        fontIncrease?.classList.add('active');
      } else {
        fontNormal?.classList.add('active');
      }
    };

    fontDecrease?.addEventListener('click', () => setFontSize('sm'));
    fontNormal?.addEventListener('click', () => setFontSize('base'));
    fontIncrease?.addEventListener('click', () => setFontSize('lg'));

    // 5. Mobile Quick Jump Dropdown
    const mobileSelect = document.getElementById('mobile-toc-select') as HTMLSelectElement | null;
    mobileSelect?.addEventListener('change', () => {
      const targetId = mobileSelect.value;
      if (targetId) {
        const targetElement = document.getElementById(targetId);
        targetElement?.scrollIntoView({ behavior: 'smooth' });
      }
    });

    // 5b. Collapsible TOC details handling on mobile
    const tocMobileDetails = document.getElementById('toc-mobile-details') as HTMLDetailsElement | null;
    if (tocMobileDetails) {
      if (window.innerWidth < 992) {
        tocMobileDetails.open = false;
      } else {
        tocMobileDetails.open = true;
      }
    }

    // 6. Category Filter Pills
    const filterPills = document.querySelectorAll('.filter-pill');
    const tocItems = document.querySelectorAll('.toc-item');

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const filterCategory = pill.getAttribute('data-filter');

        tocItems.forEach((item) => {
          const itemCat = item.getAttribute('data-category');
          if (filterCategory === 'all' || itemCat === filterCategory) {
            (item as HTMLElement).style.display = 'block';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // 7. Live Constitution Keyword Search & Filter
    const searchInput = document.getElementById('constitution-search') as HTMLInputElement | null;
    const searchFeedback = document.getElementById('search-feedback');
    const sections = document.querySelectorAll('.doc-section');

    searchInput?.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim();
      let matchedCount = 0;

      sections.forEach((sec) => {
        const text = sec.textContent?.toLowerCase() || '';
        const id = sec.getAttribute('id');
        const isMatch = query === '' || text.includes(query);

        (sec as HTMLElement).style.display = isMatch ? 'block' : 'none';

        if (id) {
          const matchingLink = document.querySelector(`[data-toc-id="${id}"]`);
          const matchingItem = document.querySelector(`[data-search-target="${id}"]`);
          if (matchingLink && matchingItem) {
            if (isMatch) {
              (matchingItem as HTMLElement).style.display = 'block';
              (matchingLink as HTMLElement).style.opacity = '1';
              matchedCount++;
            } else {
              (matchingItem as HTMLElement).style.display = 'none';
            }
          }
        }
      });

      if (searchFeedback) {
        if (query === '') {
          searchFeedback.textContent = '';
        } else {
          searchFeedback.textContent = `Found ${matchedCount} matching section${matchedCount === 1 ? '' : 's'}`;
        }
      }
    });

    // 8. Active Chapter ScrollSpy with IntersectionObserver
    const tocLinks = document.querySelectorAll('.toc-link');
    const observerOptions = {
      root: null,
      rootMargin: '-100px 0px -60% 0px',
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const activeId = entry.target.getAttribute('id');
          tocLinks.forEach((link) => {
            if (link.getAttribute('data-toc-id') === activeId) {
              link.classList.add('active');
              link.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            } else {
              link.classList.remove('active');
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));

    // 9. Back to Top Floating Button
    const backToTopBtn = document.getElementById('btn-back-to-top');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 400) {
        backToTopBtn?.classList.add('visible');
      } else {
        backToTopBtn?.classList.remove('visible');
      }
    }, { passive: true });

    backToTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // Initialize on page load and on Astro view transition page swaps
  setupConstitutionInteractivity();
  document.addEventListener('astro:page-load', setupConstitutionInteractivity);
</script>
