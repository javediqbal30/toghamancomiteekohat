---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';

const chapters = [
  { id: 'preamble', num: '0', title: 'Preamble & Foundation', urdu: 'تمہید اور بنیادی اہداف', category: 'foundation', badge: 'Foundational Charter' },
  { id: 'ch1', num: '1', title: 'Basic Objectives (Articles 1–10)', urdu: 'باب ۱: بنیادی مقاصد اور ترجیحات', category: 'governance', badge: '10 Codified Articles' },
  { id: 'ch2', num: '2', title: 'Structure of the Committee', urdu: 'باب ۲: تنظیمی ڈھانچہ و عہدہ جات', category: 'governance', badge: 'Governance Hierarchy' },
  { id: 'ch3', num: '3', title: 'The General Body', urdu: 'باب ۳: جنرل باڈی کے اختیارات', category: 'governance', badge: 'Sovereign Assembly' },
  { id: 'ch4', num: '4', title: 'The Executive Committee', urdu: 'باب ۴: مجلس عاملہ کے فرائض', category: 'governance', badge: 'Executive Mandate' },
  { id: 'ch5', num: '5', title: 'Duties of Office Holders', urdu: 'باب ۵: عہدیداران کے تفصیلی فرائض', category: 'governance', badge: 'Separation of Powers' },
  { id: 'ch6', num: '6', title: 'Meeting Procedures & Quorum', urdu: 'باب ۶: اجلاس کا طریقہ کار اور کورم', category: 'governance', badge: '50%+1 Quorum Rule' },
  { id: 'ch7', num: '7', title: 'Formal Resolution System', urdu: 'باب ۷: تحریری قراردادوں کا نظام', category: 'governance', badge: 'Mandatory 9 Fields' },
  { id: 'ch8', num: '8', title: 'Financial Transparency & Audit', urdu: 'باب ۸: مالیاتی شفافیت اور احتساب', category: 'finances', badge: 'Anti-Corruption Firewall' },
  { id: 'ch9', num: '9', title: 'Conflict of Interest', urdu: 'باب ۹: مفادات کے تصادم کی روک تھام', category: 'ethics', badge: 'Mandatory Recusal' },
  { id: 'ch10', num: '10', title: 'Complaint & Whistleblower System', urdu: 'باب ۱۰: عوامی شکایات اور وسل بلور تحفظ', category: 'ethics', badge: 'Due Process Register' },
  { id: 'ch11', num: '11', title: 'Respect for the Rule of Law', urdu: 'باب ۱۱: قانون کی مکمل بالادستی', category: 'ethics', badge: 'Zero Vigilantism' },
  { id: 'ch12', num: '12', title: 'Political Neutrality', urdu: 'باب ۱۲: غیر سیاسی و غیر جانبدار حیثیت', category: 'ethics', badge: 'Non-Partisan Platform' },
  { id: 'ch13', num: '13', title: 'Media & Communications Policy', urdu: 'باب ۱۳: میڈیا و سوشل میڈیا ضابطہ اخلاق', category: 'ethics', badge: 'Spokesperson Protocol' },
  { id: 'ch14', num: '14', title: 'Project Methodology & Lifecycle', urdu: 'باب ۱۴: ترقیاتی منصوبوں کا لائحہ عمل', category: 'operations', badge: '8-Stage Lifecycle' },
  { id: 'ch15', num: '15', title: 'Accountability & Discipline', urdu: 'باب ۱۵: ہمہ وقتی محاسبہ و جوابدہی', category: 'ethics', badge: 'Due Process Hearing' },
  { id: 'ch16', num: '16', title: 'Difference of Opinion & Decorum', urdu: 'باب ۱۶: اختلافِ رائے کا جمہوری احترام', category: 'governance', badge: 'Internal Democracy' },
  { id: 'ch17', num: '17', title: 'Term of Office & Transitions', urdu: 'باب ۱۷: مدتِ نظامت اور چارج کی منتقلی', category: 'governance', badge: '2-Year Fixed Term' },
  { id: 'ch18', num: '18', title: 'Constitutional Amendments', urdu: 'باب ۱۸: آئینی ترامیم کا طریقہ کار', category: 'governance', badge: 'Two-Thirds Majority' },
  { id: 'policy', num: 'Part 2', title: 'Operational Policy Manual', urdu: 'حصہ دوم: تنظیمی پالیسی و رہنما اصول', category: 'operations', badge: '18 Operational Rules' },
];
---

<BaseLayout
  title="Codified Constitution & Governance Charter | Togh Aman Committee"
  description="Explore the official 18-chapter codified Constitution, Rules of Procedure, and Operational Policy of Togh Aman Committee (Togh Bala & Payan, Kohat)."
>
  <!-- Redesigned Hero Section with Mouse Spotlight, Ambient Orbs & Wave Transition -->
  <section class="doc-hero-section" id="doc-hero">
    <!-- 1. Interactive Mouse Spotlight Glow Layer -->
    <div class="hero-mouse-spotlight" id="hero-mouse-glow" aria-hidden="true"></div>

    <!-- 2. Geometric Dot Matrix Pattern -->
    <div class="hero-matrix-grid" aria-hidden="true"></div>

    <!-- 3. Rising Floating Glowing Orbs -->
    <div class="floating-orbs-layer" aria-hidden="true">
      <span class="rising-orb orb-1"></span>
      <span class="rising-orb orb-2"></span>
      <span class="rising-orb orb-3"></span>
      <span class="rising-orb orb-4"></span>
      <span class="rising-orb orb-5"></span>
      <span class="rising-orb orb-6"></span>
      <span class="rising-orb orb-7"></span>
      <span class="rising-orb orb-8"></span>
      <span class="rising-orb orb-9"></span>
      <span class="rising-orb orb-10"></span>
    </div>

    <!-- 4. Scenic Wave Contour Transition -->
    <div class="hero-wave-transition" aria-hidden="true">
      <svg viewBox="0 0 1440 140" fill="none" preserveAspectRatio="none" class="wave-svg">
        <path d="M0,140 L0,90 Q360,35 720,80 Q1080,125 1440,70 L1440,140 Z" fill="rgba(6, 77, 50, 0.04)" />
        <path d="M0,140 L0,110 Q360,70 720,105 Q1080,138 1440,95 L1440,140 Z" fill="rgba(212, 160, 23, 0.05)" />
      </svg>
    </div>

    <div class="container hero-content-container text-center">
      <div class="hero-badge-cluster">
        <Badge variant="gold">Official Document &bull; باضابطہ قانونی دستور</Badge>
        <span class="hero-status-pill">
          <Icon name="shield" size={14} class="text-green" />
          <span>18 Codified Chapters &bull; Enacted 25 August 2026</span>
        </span>
      </div>

      <h1 class="page-title">Codified Constitution &amp; Rules of Procedure</h1>
      <span class="urdu-hero-title urdu-text" dir="rtl">توغ امن کمیٹی — متفقہ منظور شدہ دستور اور قواعد و ضوابط</span>

      <div class="hero-quote-box">
        <p class="hero-quote-urdu urdu-text" dir="rtl">
          "توغ پبلک کمیٹی کسی فرد واحد کی ذاتی جاگیر نہیں، یہ عوام کی مقدس امانت ہے۔"
        </p>
        <p class="hero-quote-en">
          "The Togh Public Committee is not the property of any person. It is a sacred trust of the people."
        </p>
        <span class="hero-quote-citation">— Foundational Oath &amp; Constitutional Decree, Togh Bala &amp; Payan</span>
      </div>

      <!-- Live Hero Metrics Strip -->
      <div class="hero-metrics-strip">
        <div class="metric-pill">
          <strong class="metric-num">18</strong>
          <span class="metric-txt">Codified Chapters</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-pill">
          <strong class="metric-num">50% + 1</strong>
          <span class="metric-txt">Mandatory Quorum</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-pill">
          <strong class="metric-num">2 Years</strong>
          <span class="metric-txt">Tenure Limit</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-pill">
          <strong class="metric-num">0</strong>
          <span class="metric-txt">Personal Accounts</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="hero-cta-group">
        <a href="#preamble" class="btn-hero-explore">
          <span>Read Constitution / دستور کا مطالعہ</span>
          <Icon name="arrow-right" size={15} />
        </a>
        <button type="button" class="btn-hero-print" id="btn-print-constitution" aria-label="Print or save as PDF">
          <Icon name="document" size={16} />
          <span>Print / Save as PDF</span>
        </button>
        <Button variant="outline" size="md" href="/transparency">
          <Icon name="balance" size={16} />
          <span>Transparency Centre</span>
        </Button>
      </div>
    </div>
  </section>

  <!-- Legal Document Controls Utility Bar -->
  <div class="doc-utility-bar">
    <div class="container doc-utility-inner">
      <div class="utility-left">
        <span class="meta-tag">
          <Icon name="map-pin" size={14} />
          <span>Togh, Kohat, KP</span>
        </span>
        <span class="meta-sep">&bull;</span>
        <span class="meta-tag">
          <Icon name="calendar" size={14} />
          <span>Opening: 25 August 2026</span>
        </span>
        <span class="meta-sep">&bull;</span>
        <span class="meta-tag tag-founder">
          <Icon name="shield" size={14} />
          <span>Founder: Hadayatullah Khan</span>
        </span>
        <span class="meta-sep">&bull;</span>
        <span class="meta-tag tag-pres">
          <Icon name="users" size={14} />
          <span>President: Malik Ihsanullah</span>
        </span>
      </div>

      <div class="utility-right">
        <!-- Font Size Switcher -->
        <div class="font-resizer-wrap" aria-label="Adjust font size">
          <span class="resizer-label">Font:</span>
          <button class="font-btn" id="font-decrease" aria-label="Decrease text size" title="Smaller font">A-</button>
          <button class="font-btn active" id="font-normal" aria-label="Default text size" title="Default font">A</button>
          <button class="font-btn" id="font-increase" aria-label="Increase text size" title="Larger font">A+</button>
        </div>

        <!-- Quick Jump Select on Mobile -->
        <div class="mobile-jump-wrap">
          <select id="mobile-toc-select" class="mobile-jump-select" aria-label="Quick jump to chapter">
            <option value="">Jump to Chapter / باب منتخب کریں...</option>
            {chapters.map((ch) => (
              <option value={ch.id}>{ch.num === '0' || ch.num === 'Part 2' ? '' : `Ch. ${ch.num}: `}{ch.title}</option>
            ))}
          </select>
        </div>
      </div>
    </div>
  </div>

  <div class="container doc-layout-container" id="reading-content">
    <!-- Sticky Desktop Table of Contents Sidebar -->
    <aside class="toc-sidebar">
      <details class="toc-sticky-box card" id="toc-mobile-details" open>
        <summary class="toc-mobile-summary">
          <div class="toc-summary-left">
            <Icon name="document" size={18} class="text-gold" />
            <span class="toc-summary-title">Table of Contents / فہرستِ ابواب</span>
          </div>
          <span class="toc-badge-count">{chapters.length} Sections</span>
        </summary>

        <div class="toc-expanded-body">
          <div class="toc-header-row">
            <div class="toc-heading-wrap">
              <h2 class="toc-heading">Table of Contents</h2>
              <span class="toc-subheading urdu-text" dir="rtl">فہرستِ ابواب و آئینی دفعات</span>
            </div>
            <span class="toc-badge-count">{chapters.length} Sections</span>
          </div>

          <!-- Instant Filter Search Input -->
          <div class="toc-search-wrap">
            <div class="search-input-box">
              <Icon name="search" size={15} class="search-icon" />
              <input 
                type="search" 
                id="constitution-search" 
                placeholder="Search articles, keywords (e.g. Quorum, Bank)..." 
                class="toc-search-input"
                aria-label="Search Constitution articles"
              />
            </div>
            <div class="search-results-feedback" id="search-feedback" aria-live="polite"></div>
          </div>

          <!-- Quick Filter Category Tabs -->
          <div class="toc-filter-pills" role="tablist" aria-label="Filter chapters by category">
            <button class="filter-pill active" data-filter="all">All</button>
            <button class="filter-pill" data-filter="governance">Governance</button>
            <button class="filter-pill" data-filter="finances">Finances</button>
            <button class="filter-pill" data-filter="ethics">Ethics &amp; Law</button>
            <button class="filter-pill" data-filter="operations">Operations</button>
          </div>

          <!-- Scrollable Navigation Items -->
          <nav class="toc-nav" aria-label="Constitution Chapters">
            <ul class="toc-list" id="toc-list-items">
              {chapters.map((ch) => (
                <li class="toc-item" data-category={ch.category} data-search-target={ch.id}>
                  <a href={`#${ch.id}`} class="toc-link" data-toc-id={ch.id}>
                    <span class="toc-item-num">{ch.num}</span>
                    <div class="toc-item-text">
                      <span class="toc-item-title">{ch.title}</span>
                      <span class="toc-item-urdu urdu-text" dir="rtl">{ch.urdu}</span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="toc-footer-card">
            <div class="toc-footer-icon">
              <Icon name="shield" size={18} class="text-gold" />
            </div>
            <div class="toc-footer-text">
              <strong>Certified Legal Document</strong>
              <p>Ratified under public consensus on 25 August 2026.</p>
            </div>
          </div>
        </div>
      </details>
    </aside>

    <!-- Main Constitution Text Content Area -->
    <main class="doc-content" id="doc-main-content">
      
      <!-- Preamble -->
      <section id="preamble" class="doc-section card reveal-on-scroll">
        <div class="section-meta-header">
          <span class="article-badge">Foundational Text &bull; دیباچہ</span>
          <span class="chapter-index-chip">Ratified Charter</span>
        </div>
        <h2>Preamble &amp; Foundation</h2>
        <span class="urdu-section-title urdu-text" dir="rtl">تمہید — توغ امن کمیٹی کی بنیاد، نصب العین اور اساسی مقاصد</span>

        <p class="lead-text">
          The <strong>Togh Public Committee (Togh Bala &amp; Payan)</strong> is established as an independent, non-political, and non-sectarian public welfare platform dedicated to the collective elevation, security, and lawful advancement of all citizens.
        </p>

        <div class="aims-grid">
          <div class="aim-item">
            <div class="aim-check"><Icon name="check" size={16} /></div>
            <div>
              <strong>Peace &amp; Civil Order</strong>
              <p>Promote brotherhood, mutual respect, and active mediation of tribal and personal disputes.</p>
            </div>
          </div>
          <div class="aim-item">
            <div class="aim-check"><Icon name="check" size={16} /></div>
            <div>
              <strong>Rule of Law &amp; State Institutions</strong>
              <p>Work hand in hand with district police and civil administration in complete respect of Pakistani law.</p>
            </div>
          </div>
          <div class="aim-item">
            <div class="aim-check"><Icon name="check" size={16} /></div>
            <div>
              <strong>Protection of Public Rights</strong>
              <p>Ensure women, children, laborers, and vulnerable residents are shielded from injustice and exploitation.</p>
            </div>
          </div>
          <div class="aim-item">
            <div class="aim-check"><Icon name="check" size={16} /></div>
            <div>
              <strong>Transparent &amp; Audited Civic Works</strong>
              <p>Demand documented accountability for roads, clean water, healthcare, and village electrification.</p>
            </div>
          </div>
          <div class="aim-item">
            <div class="aim-check"><Icon name="check" size={16} /></div>
            <div>
              <strong>Youth Empowerment &amp; Sports</strong>
              <p>Cultivate technical training, sports tournaments, and zero-tolerance anti-narcotics advocacy.</p>
            </div>
          </div>
          <div class="aim-item">
            <div class="aim-check"><Icon name="check" size={16} /></div>
            <div>
              <strong>Protection of Shamilat (Shared Lands)</strong>
              <p>Guard communal lands, grazing pastures, and natural resources against fraudulent land grabbers.</p>
            </div>
          </div>
        </div>

        <div class="principle-callout mt-4">
          <div class="callout-icon"><Icon name="balance" size={22} class="text-primary" /></div>
          <div class="callout-text">
            <strong>The Paramount Common Good Mandate:</strong>
            <p>The Committee will never be utilized for the personal, economic, or political benefit of any single person, family, or faction. The common welfare of the entire area shall always take inviolable precedence.</p>
          </div>
        </div>
      </section>

      <!-- Chapter 1 -->
      <section id="ch1" class="doc-section card reveal-on-scroll">
        <div class="section-meta-header">
          <span class="article-badge">Codified Articles 1 – 10 &bull; بنیادی مقاصد</span>
          <span class="chapter-index-chip">Chapter 1</span>
        </div>
        <h2>Chapter 1 — Basic Objectives</h2>
        <span class="urdu-section-title urdu-text" dir="rtl">باب اول — دس بنیادی مقاصد اور ترجیحی ذمہ داریاں</span>

        <div class="articles-accordion">
          <div class="article-block">
            <div class="article-head">
              <span class="article-num">Article 1</span>
              <h3>Peace, Brotherhood and Dispute Resolution</h3>
            </div>
            <p>Promote peace, brotherhood, mutual respect, and unity across Togh Bala and Togh Payan. The Committee will play an active, constructive, and neutral role in resolving personal, family, and tribal disputes peacefully through documented consultation.</p>
          </div>

          <div class="article-block highlight-danger">
            <div class="article-head">
              <span class="article-num text-danger">Article 2</span>
              <h3>Preventing Crime &amp; Eradication of Narcotics (Anti-Ice)</h3>
            </div>
            <p>Collaborate strictly within legal parameters with DPO Kohat and district police against narcotics distribution (specifically ice/crystal meth), theft, scrap yard irregularities, illegal gambling, and anti-social evils that endanger village youth.</p>
          </div>

          <div class="article-block">
            <div class="article-head">
              <span class="article-num">Article 3</span>
              <h3>Rights of Children &amp; Women</h3>
            </div>
            <p>Work proactively to safeguard the legal, educational, healthcare, and social rights of children and women through the dedicated Women's Wing and family welfare sub-committees.</p>
          </div>

          <div class="article-block">
            <div class="article-head">
              <span class="article-num">Article 4</span>
              <h3>Civic Development &amp; Public Infrastructure</h3>
            </div>
            <p>Present documented petitions before relevant state departments regarding asphalt roads, clean drinking water supply, electricity transformers, school facilities, dispensaries, street drainage, and sports grounds.</p>
          </div>

          <div class="article-block">
            <div class="article-head">
              <span class="article-num">Article 5</span>
              <h3>Royalty &amp; Development Funds Oversight</h3>
            </div>
            <p>Gather official documentation and interface with provincial and district authorities to ensure oil, gas, and mineral royalties allocated for Togh are utilized transparently, equitably, and without diversion.</p>
          </div>

          <div class="article-block highlight-gold">
            <div class="article-head">
              <span class="article-num text-gold">Article 6</span>
              <h3>Protection of Shamilat (Common Lands)</h3>
            </div>
            <p>Approach civil courts and revenue authorities to initiate prompt legal proceedings against unauthorized occupation, unlawful sale, or commercial exploitation of village common and shared communal lands.</p>
          </div>

          <div class="article-block">
            <div class="article-head">
              <span class="article-num">Article 7</span>
              <h3>Youth Empowerment &amp; Vocational Opportunities</h3>
            </div>
            <p>Facilitate youth employment linkages, technical vocational courses, digital education, IT training, and athletic tournaments to direct young talent toward constructive nation-building paths.</p>
          </div>

          <div class="article-block">
            <div class="article-head">
              <span class="article-num">Article 8</span>
              <h3>Patwari &amp; Land Revenue Transparency</h3>
            </div>
            <p>Liaise with the Kohat district administration to ensure revenue records (Fard, Intiqal, Registry) are maintained transparently, public citizens are served promptly without illicit facilitation fees, and administrative bottlenecks are eliminated.</p>
          </div>

          <div class="article-block">
            <div class="article-head">
              <span class="article-num">Article 9</span>
              <h3>Education &amp; Public Health Infrastructure</h3>
            </div>
            <p>Make concerted joint efforts to inspect, audit, and improve staff attendance, teacher availability, basic medical supplies, and equipment in local government primary/high schools and Basic Health Units (BHUs).</p>
          </div>

          <div class="article-block">
            <div class="article-head">
              <span class="article-num">Article 10</span>
              <h3>Environmental Protection &amp; Natural Resources</h3>
            </div>
            <p>Spread ecological awareness and initiate practical community drives to protect underground water aquifers, village pastures, hillsides, and surrounding natural resources against degradation.</p>
          </div>
        </div>
      </section>

      <!-- Chapter 2 -->
      <section id="ch2" class="doc-section card reveal-on-scroll">
        <div class="section-meta-header">
          <span class="article-badge">Institutional Framework &bull; تنظیمی ڈھانچہ</span>
          <span class="chapter-index-chip">Chapter 2</span>
        </div>
        <h2>Chapter 2 — Structure of the Committee</h2>
        <span class="urdu-section-title urdu-text" dir="rtl">باب دوم — کمیٹی کا تنظیمی ڈھانچہ اور ذیلی باڈیز</span>

        <p>The Committee functions under a formalized separation of powers, comprising distinct advisory, executive, consultative, and sovereign tiers:</p>

        <div class="structure-pillars-grid">
          <div class="struct-card">
            <div class="struct-icon"><Icon name="shield" size={24} class="text-gold" /></div>
            <h4>1. Advisory Council</h4>
            <p>Legal Advisors and constitutional scholars who review all resolutions and administrative actions for statutory and legal compliance.</p>
          </div>

          <div class="struct-card">
            <div class="struct-icon"><Icon name="users" size={24} class="text-green" /></div>
            <h4>2. Executive Committee</h4>
            <p>Patron/Chairman, President, Senior Vice President, 2nd VP, General Secretary, Joint Secretaries, Finance Secretary, Media Secretary, Youth &amp; Overseas Secretaries.</p>
          </div>

          <div class="struct-card">
            <div class="struct-icon"><Icon name="balance" size={24} class="text-gold" /></div>
            <h4>3. Ulama &amp; Consultative Bodies</h4>
            <p>Council of recognized religious scholars (Ulama) reviewing matters through the lens of Shariah and Islamic jurisprudence.</p>
          </div>

          <div class="struct-card">
            <div class="struct-icon"><Icon name="dove" size={24} class="text-green" /></div>
            <h4>4. Dedicated Specialized Wings</h4>
            <p>Women's Wing, Youth &amp; Sports Vigilance Wing, Overseas Coordination Cell, and specific departmental sub-committees.</p>
          </div>
        </div>
      </section>

      <!-- Chapter 3 -->
      <section id="ch3" class="doc-section card reveal-on-scroll">
        <div class="section-meta-header">
          <span class="article-badge">Supreme Sovereignty &bull; عمومی مجلس</span>
          <span class="chapter-index-chip">Chapter 3</span>
        </div>
        <h2>Chapter 3 — The General Body</h2>
        <span class="urdu-section-title urdu-text" dir="rtl">باب سوم — جنرل باڈی کی حیثیت، اختیارات اور فیصلہ سازی</span>

        <p class="lead-text">
          The <strong>General Body (الجمعیۃ العامة)</strong> is the supreme sovereign assembly of the Togh Aman Committee, embodying the collective voice of the people.
        </p>

        <div class="powers-card">
          <h4>Constitutional Powers of the General Body:</h4>
          <ul class="styled-doc-list">
            <li><strong>Basic Policy Sanction:</strong> Formally approve and rectify the foundational manifesto, annual policy priorities, and development agenda.</li>
            <li><strong>Cabinet Election &amp; Dissolution:</strong> Elect the Executive Cabinet and hold the sole constitutional authority to dissolve or impeach the cabinet through a vote of no confidence.</li>
            <li><strong>Annual Performance Scrutiny:</strong> Convene annually to audit performance reports, financial balances, and administrative achievements of all office holders.</li>
            <li><strong>Constitutional Amendments:</strong> Sole authority to enact, alter, or repeal any article or clause of this Constitution by a two-thirds majority vote.</li>
          </ul>
