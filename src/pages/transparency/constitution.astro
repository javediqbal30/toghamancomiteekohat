     Layout Container: Sticky Sidebar & Main Doc Content
     ========================================================================== */
  .doc-layout-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  @media (min-width: 992px) {
    .doc-layout-container {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  /* Sidebar Navigation */
  .toc-sidebar {
    width: 100%;
  }

  @media (min-width: 992px) {
    .toc-sidebar {
      width: 330px;
      flex-shrink: 0;
      position: sticky;
      top: calc(var(--header-height, 0) + 52px);
      max-height: calc(100vh - var(--header-height, 0) - 72px);
      display: flex;
      flex-direction: column;
    }
  }

  .toc-sticky-box {
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    max-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
  }

  /* Mobile Accordion Summary */
  .toc-mobile-summary {
    display: none;
  }

  .toc-expanded-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  @media (max-width: 991px) {
    .toc-sticky-box {
      max-height: none;
      padding: var(--space-3) var(--space-4);
    }

    .toc-mobile-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      font-weight: 700;
      color: var(--color-primary);
      list-style: none;
      user-select: none;
    }

    .toc-mobile-summary::-webkit-details-marker {
      display: none;
    }

    .toc-summary-left {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
    }

    .toc-header-row {
      display: none;
    }

    .toc-expanded-body {
      margin-top: var(--space-4);
      padding-top: var(--space-3);
      border-top: 1px solid var(--color-border);
    }
  }

  .toc-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-gold);
  }

  .toc-heading-wrap {
    display: flex;
    flex-direction: column;
  }

  .toc-heading {
    font-size: 16px;
    font-weight: 800;
    color: var(--color-primary);
    margin: 0;
  }

  .toc-subheading {
    font-size: 13px;
    color: var(--color-green);
    margin-top: 2px;
  }

  .toc-badge-count {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-surface-subtle);
    padding: 3px 8px;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
  }

  .toc-search-wrap {
    margin-bottom: var(--space-3);
  }

  .search-input-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 10px;
    color: var(--color-text-subtle);
    pointer-events: none;
  }

  .toc-search-input {
    width: 100%;
    padding: 8px 10px 8px 32px;
    font-size: 13px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface-subtle);
    color: var(--color-text);
    transition: border-color var(--duration-fast);
  }

  .toc-search-input:focus {
    outline: none;
    border-color: var(--color-primary);
    background: #FFFFFF;
  }

  .search-results-feedback {
    font-size: 11px;
    color: var(--color-green);
    font-weight: 600;
    margin-top: 4px;
    min-height: 16px;
  }

  .toc-filter-pills {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    padding-bottom: 8px;
    margin-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .filter-pill {
    border: none;
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    font-size: 11px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 9999px;
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--duration-fast);
  }

  .filter-pill.active, .filter-pill:hover {
    background: var(--color-primary);
    color: #FFFFFF;
  }

  .toc-nav {
    overflow-y: auto;
    flex: 1;
    padding-right: 4px;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .toc-item {
    transition: opacity var(--duration-fast);
  }

  .toc-link {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 6px 8px;
    border-radius: var(--radius-xs);
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 12.5px;
    line-height: 1.35;
    transition: all var(--duration-fast);
    border-left: 3px solid transparent;
  }

  .toc-item-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 4px;
    border-radius: 4px;
    background: var(--color-surface-subtle);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .toc-item-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc-item-title {
    font-weight: 500;
  }

  .toc-item-urdu {
    font-size: 11.5px;
    color: var(--color-text-subtle);
  }

  .toc-link:hover {
    background: var(--color-surface-subtle);
    color: var(--color-primary);
  }

  .toc-link.active {
    background: rgba(6, 77, 50, 0.08);
    color: var(--color-primary);
    font-weight: 700;
    border-left-color: var(--color-gold);
  }

  .toc-link.active .toc-item-num {
    background: var(--color-gold);
    color: var(--color-gold-text);
  }

  .toc-link.active .toc-item-urdu {
    color: var(--color-green);
    font-weight: 600;
  }

  .toc-footer-card {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: 11px;
  }

  .toc-footer-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(212, 160, 23, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .toc-footer-text p {
    margin: 2px 0 0;
    color: var(--color-text-subtle);
  }

  /* ==========================================================================
     Main Document Content & Chapter Sections
     ========================================================================== */
  .doc-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .doc-section {
    padding: var(--space-8);
    scroll-margin-top: calc(var(--header-height, 0) + 72px);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
    position: relative;
    transition: transform var(--duration-fast);
  }

  .card-gold-accent {
    border-top: 4px solid var(--color-gold);
  }

  .section-meta-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .article-badge {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold-dark);
  }

  .chapter-index-chip {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-surface-subtle);
    padding: 3px 10px;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
  }

  .doc-section h2 {
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 2px;
    line-height: 1.25;
  }

  .urdu-section-title {
    display: block;
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    font-weight: 700;
    color: var(--color-green);
    margin-bottom: var(--space-4);
    line-height: 1.8;
  }

  .lead-text {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  /* Foundational Aims Grid */
  .aims-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
    margin-top: var(--space-4);
  }

  .aim-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: var(--color-surface-subtle);
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .aim-check {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .aim-item strong {
    display: block;
    font-size: 14px;
    color: var(--color-primary);
    margin-bottom: 2px;
  }

  .aim-item p {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.45;
  }

  .principle-callout {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: rgba(6, 77, 50, 0.05);
    border-left: 4px solid var(--color-primary);
    padding: 16px 20px;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .callout-icon {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .callout-text strong {
    font-size: 14px;
    color: var(--color-primary);
    display: block;
    margin-bottom: 4px;
  }

  .callout-text p {
    font-size: 13.5px;
    color: var(--color-text);
    margin: 0;
    line-height: 1.5;
  }

  /* Articles Accordion List */
  .articles-accordion {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: var(--space-4);
  }

  .article-block {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 16px 20px;
    transition: transform var(--duration-fast);
  }

  .article-block:hover {
    transform: translateX(4px);
  }

  .article-block.highlight-danger {
    border-left: 4px solid var(--color-danger);
    background: #FFF9F9;
  }

  .article-block.highlight-gold {
    border-left: 4px solid var(--color-gold);
    background: #FFFDF5;
  }

  .article-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  .article-num {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    background: #FFFFFF;
    color: var(--color-primary);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  .article-block h3 {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
  }

  .article-block p {
    font-size: 13.5px;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  /* Chapter 2 Structure Grid */
  .structure-pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin-top: var(--space-4);
  }

  .struct-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 18px 20px;
  }

  .struct-icon {
    margin-bottom: 10px;
  }

  .struct-card h4 {
    font-size: 15px;
    color: var(--color-primary);
    margin-bottom: 6px;
  }

  .struct-card p {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* Chapter 3 Powers */
  .powers-card {
    background: rgba(212, 160, 23, 0.06);
    border: 1px solid rgba(212, 160, 23, 0.3);
    border-radius: var(--radius-sm);
    padding: 20px 24px;
    margin-top: var(--space-4);
  }

  .powers-card h4 {
    font-size: 15px;
    color: var(--color-gold-dark);
    margin-bottom: 12px;
  }

  .styled-doc-list {
    margin: 0;
    padding-left: 20px;
    font-size: 13.5px;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    gap: 8px;
    line-height: 1.55;
  }

  /* Chapter 4 Exec Duties */
  .exec-duties-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 10px;
    margin-top: var(--space-4);
  }

  .exec-duty-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    font-size: 13px;
    color: var(--color-text);
    font-weight: 500;
  }

  /* Chapter 5 Officers Roster */
  .officers-roster {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-top: var(--space-4);
  }

  .officer-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
  }

  .officer-badge {
    align-self: flex-start;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--color-primary);
    color: #FFFFFF;
    padding: 2px 8px;
    border-radius: 4px;
    margin-bottom: 8px;
  }

  .officer-card h3 {
    font-size: 16px;
    color: var(--color-primary);
    margin-bottom: 8px;
  }

  .officer-card p {
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0 0 12px;
    flex: 1;
  }

  .officer-caveat {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    background: #FFFDF5;
    border: 1px solid rgba(212, 160, 23, 0.4);
    border-radius: var(--radius-xs);
    padding: 8px 10px;
    font-size: 11.5px;
    color: #78350F;
    line-height: 1.4;
  }

  .officer-note {
    background: #FFFFFF;
    border-left: 3px solid var(--color-green);
    padding: 6px 10px;
    font-size: 11.5px;
    color: var(--color-green);
    font-weight: 600;
  }

  /* Chapter 6 Meeting Stepper */
  .rules-stepper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    margin-top: var(--space-4);
  }

  .step-card {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .step-card strong {
    display: block;
    font-size: 13.5px;
    color: var(--color-primary);
    margin-bottom: 3px;
  }

  .step-card p {
    font-size: 12px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.45;
  }

  /* Interactive Quorum Calculator */
  .interactive-tool-box {
    background: #FFFFFF;
    border: 2px solid var(--color-gold);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: 0 4px 20px rgba(212, 160, 23, 0.12);
  }

  .tool-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .tool-title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .tool-title-wrap h4 {
    font-size: 17px;
    color: var(--color-primary);
  }

  .tool-sub {
    font-size: 13px;
    color: var(--color-green);
    margin-top: 2px;
  }

  .tool-pill {
    font-size: 11px;
    font-weight: 700;
    background: var(--color-gold);
    color: var(--color-gold-text);
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .tool-desc {
    font-size: 13.5px;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-4);
  }

  .calculator-panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .slider-group {
    background: var(--color-surface-subtle);
    padding: 16px 20px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .slider-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-primary);
  }

  .quorum-range-slider {
    width: 100%;
    cursor: pointer;
    accent-color: var(--color-primary);
    height: 8px;
  }

  .slider-markers {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--color-text-subtle);
    margin-top: 6px;
  }

  .marker-threshold {
    font-weight: 700;
    color: var(--color-gold-dark);
  }

  .quorum-status-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 20px;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast);
  }

  .quorum-status-card.status-valid {
    background: #ECFDF5;
    border: 1.5px solid #059669;
    color: #065F46;
  }

  .quorum-status-card.status-invalid {
    background: #FEF2F2;
    border: 1.5px solid #DC2626;
    color: #991B1B;
  }

  .status-content h4 {
    font-size: 14.5px;
    margin: 0 0 4px;
    font-weight: 800;
  }

  .status-content p {
    font-size: 13px;
    margin: 0;
    line-height: 1.45;
  }

  /* Chapter 7 Specimen Resolution Card */
  .specimen-card {
    background: #FFFFFF;
    border: 2px dashed var(--color-gold);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    margin-top: var(--space-4);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.02);
  }

  .specimen-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .specimen-stamp {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 800;
    color: var(--color-primary);
  }

  .specimen-badge {
    font-size: 11px;
    font-weight: 700;
    background: rgba(6, 77, 50, 0.08);
    color: var(--color-primary);
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  .specimen-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  @media (max-width: 640px) {
    .specimen-grid {
      grid-template-columns: 1fr;
    }
  }

  .specimen-field {
    background: var(--color-surface-subtle);
    padding: 10px 14px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border);
  }

  .specimen-field.col-full {
    grid-column: 1 / -1;
  }

  .field-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: 3px;
  }

  .field-val {
    font-size: 13.5px;
    color: var(--color-primary);
  }

  .field-p {
    font-size: 13px;
    color: var(--color-text);
    margin: 0;
    line-height: 1.45;
  }

  /* Chapter 8 Finance Rules */
  .finance-rules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
    margin-top: var(--space-4);
  }

  .fin-rule-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
  }

  .fin-rule-card.highlight-glow {
    border-left: 4px solid var(--color-gold);
    background: #FFFDF5;
  }

  .fin-rule-card.highlight-danger {
    border-left: 4px solid var(--color-danger);
    background: #FFF9F9;
  }

  .rule-index {
    font-size: 11px;
    font-weight: 800;
    color: var(--color-primary);
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .fin-rule-card h4 {
    font-size: 14.5px;
    color: var(--color-primary);
    margin-bottom: 6px;
  }

  .fin-rule-card p {
    font-size: 12.5px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.45;
  }

  /* Chapter 9 Ethics */
  .ethics-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
    margin-top: var(--space-4);
  }

  .ethics-step {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 16px 18px;
  }

  .ethics-icon {
    margin-top: 2px;
  }

  .ethics-step strong {
    font-size: 14px;
    color: var(--color-primary);
    display: block;
    margin-bottom: 4px;
  }

  .ethics-step p {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.45;
  }

  /* Chapter 10 Complaint Workflow */
  .workflow-box {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 18px 20px;
    margin-top: var(--space-4);
  }

  .workflow-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .workflow-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .wf-node {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-primary);
  }

  .wf-arrow {
    color: var(--color-gold);
    font-weight: 800;
  }

  .whistleblower-banner {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #ECFDF5;
    border: 1px solid #6EE7B7;
    border-radius: var(--radius-sm);
    padding: 14px 18px;
    color: #065F46;
  }

  .whistleblower-banner p {
    font-size: 13px;
    margin: 0;
    line-height: 1.5;
  }

  /* Chapter 13 Media Prohibited */
  .prohibited-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 10px;
    margin-top: var(--space-4);
  }

  .prohib-item {
