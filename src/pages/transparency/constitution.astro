    color: #991B1B;
    font-weight: 600;
  }

  /* Chapter 14 Project Lifecycle */
  .project-stages-flow {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 8px;
    margin-top: var(--space-4);
  }

  .stage-step {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
