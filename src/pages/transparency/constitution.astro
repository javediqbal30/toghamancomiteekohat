            </div>
          </div>
          <div class="step-card">
            <span class="step-num">4</span>
            <div>
              <strong>Codified Resolution</strong>
              <p>All binding commitments must be cast into a numbered, dated resolution document.</p>
            </div>
          </div>
        </div>

