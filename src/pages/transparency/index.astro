---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';

// Fetch live resolutions and projects to show live transparency snapshot
const allResolutions = await getCollection('resolutions');
const publicResolutions = allResolutions
  .filter((r) => r.data.visibility === 'Public')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const allProjects = await getCollection('projects');
const activeProjects = allProjects.slice(0, 3);
---

<BaseLayout
  title="Transparency & Public Accountability Centre | Togh Aman Committee"
  description="Inspect official public records, the 18-chapter codified constitution, approved resolutions register, active development projects, and financial audit standards of Togh Aman Committee."
>
  <!-- Hero Section with Interactive Spotlight & Rising Particles -->
  <section class="trans-hero-section" id="trans-hero">
    <!-- Interactive Mouse Spotlight Glow -->
    <div class="hero-mouse-spotlight" id="hero-mouse-glow" aria-hidden="true"></div>

    <!-- Geometric Matrix Dot Grid -->
    <div class="hero-matrix-grid" aria-hidden="true"></div>

    <!-- Rising Subtle Glowing Orbs -->
    <div class="floating-orbs-layer" aria-hidden="true">
      <span class="rising-orb orb-1"></span>
      <span class="rising-orb orb-2"></span>
      <span class="rising-orb orb-3"></span>
      <span class="rising-orb orb-4"></span>
      <span class="rising-orb orb-5"></span>
      <span class="rising-orb orb-6"></span>
      <span class="rising-orb orb-7"></span>
      <span class="rising-orb orb-8"></span>
      <span class="rising-orb orb-9"></span>
      <span class="rising-orb orb-10"></span>
    </div>

    <!-- Wave Contour Transition -->
    <div class="hero-wave-transition" aria-hidden="true">
      <svg viewBox="0 0 1440 140" fill="none" preserveAspectRatio="none" class="wave-svg">
        <path d="M0,140 L0,90 Q360,35 720,80 Q1080,125 1440,70 L1440,140 Z" fill="rgba(6, 77, 50, 0.04)" />
        <path d="M0,140 L0,110 Q360,70 720,105 Q1080,138 1440,95 L1440,140 Z" fill="rgba(212, 160, 23, 0.05)" />
      </svg>
    </div>

    <div class="container hero-content-container text-center">
      <div class="hero-badge-cluster">
        <Badge variant="gold">Public Accountability &amp; Merit</Badge>
        <span class="hero-status-pill">
          <Icon name="shield" size={14} class="text-green" />
          <span>Codified 18 Chapters &bull; باضابطہ عوامی احتساب</span>
        </span>
      </div>

      <h1 class="page-title">Transparency &amp; Governance Centre</h1>
      <span class="urdu-hero-title urdu-text" dir="rtl">توغ امن کمیٹی — شفافیت، میرٹ اور ہمہ وقتی عوامی احتساب</span>

      <div class="hero-quote-box">
        <p class="hero-quote-urdu urdu-text" dir="rtl">
          "ہر روپیہ ریکارڈ پر، ہر فیصلہ تحریری، اور ہر عہدیدار عوام کے سامنے جوابدہ۔"
        </p>
        <p class="hero-quote-en">
          "Every single rupee recorded, every community decision committed to writing, and every office holder accountable to the citizens of Togh Bala &amp; Payan."
        </p>
      </div>

      <!-- Live Metrics Strip -->
      <div class="hero-metrics-strip">
        <div class="metric-pill">
          <strong class="metric-num">18</strong>
          <span class="metric-txt">Constitutional Chapters</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-pill">
          <strong class="metric-num">100%</strong>
          <span class="metric-txt">Audited Vouchers</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-pill">
          <strong class="metric-num">0</strong>
          <span class="metric-txt">Personal Accounts (Ch. 8)</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-pill">
          <strong class="metric-num">24/7</strong>
          <span class="metric-txt">Open Public Register</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="hero-cta-group">
        <a href="#records-grid" class="btn-hero-explore">
          <span>Explore Public Records</span>
          <Icon name="arrow-right" size={15} />
        </a>
        <Button variant="outline" size="md" href="/complaints">
          <Icon name="alert" size={16} />
          <span>Submit Grievance / شکایت درج کریں</span>
        </Button>
      </div>
    </div>
  </section>

  <!-- 4 Core Constitutional Safeguards -->
  <section class="section section-safeguards">
    <div class="container">
      <div class="section-header text-center">
        <Badge variant="green">Constitutional Guarantees</Badge>
        <h2 class="section-title">4 Ironclad Pillars of Financial &amp; Legal Integrity</h2>
        <p class="section-subtitle urdu-text" dir="rtl">
          کمیٹی کے منظور شدہ آئین کے 4 ناقابلِ تنسیخ اصول جن کے ذریعے بدعنوانی، صوابدیدی اختیارات اور خفیہ فیصلوں کا مکمل خاتمہ کیا گیا ہے:
        </p>
      </div>

      <div class="safeguards-grid">
        <!-- 1. Zero Personal Accounts -->
        <div class="safeguard-card card reveal-on-scroll">
          <div class="safeguard-icon-wrap icon-green">
            <Icon name="lock" size={26} />
          </div>
          <div class="safeguard-header">
            <span class="safeguard-article">Chapter 8 &bull; Financial Integrity</span>
            <h3>No Personal Accounts</h3>
            <span class="urdu-safeguard-name urdu-text" dir="rtl">ذاتی بینک اکاؤنٹس پر مکمل پابندی</span>
          </div>
          <p>
            Operating personal bank accounts for community collections is constitutionally prohibited. All donations pass exclusively through official designated accounts with verified receipts.
          </p>
          <div class="safeguard-badge">
            <Icon name="check" size={14} class="text-green" />
            <span>Strict Anti-Corruption Firewall</span>
          </div>
        </div>

        <!-- 2. Dual Authorization Ledger -->
        <div class="safeguard-card card reveal-on-scroll delay-1">
          <div class="safeguard-icon-wrap icon-gold">
            <Icon name="balance" size={26} />
          </div>
          <div class="safeguard-header">
            <span class="safeguard-article">Chapter 5 &bull; Dual-Signatory Ledger</span>
            <h3>Two-Signature Rule</h3>
            <span class="urdu-safeguard-name urdu-text" dir="rtl">دوہری دستخطی توثیق کا لازمی نظام</span>
          </div>
          <p>
            No single office holder can withdraw or disburse funds independently. Every expenditure mandates dual signatures from the President and Finance Secretary alongside supporting merchant vouchers.
          </p>
          <div class="safeguard-badge">
            <Icon name="check" size={14} class="text-green" />
            <span>100% Counter-Signed Vouchers</span>
          </div>
        </div>

        <!-- 3. Mandatory Council Quorum -->
        <div class="safeguard-card card reveal-on-scroll delay-2">
          <div class="safeguard-icon-wrap icon-green">
            <Icon name="users" size={26} />
          </div>
          <div class="safeguard-header">
            <span class="safeguard-article">Chapter 11 &bull; Democratic Consensus</span>
            <h3>Quorum Bound Decisions</h3>
            <span class="urdu-safeguard-name urdu-text" dir="rtl">50%+1 کا لازمی جمہوری کورم</span>
          </div>
          <p>
            Arbitrary solo decisions are strictly null and void. All collective policy resolutions require minimum 50%+1 quorum of the 21 council seats, fully documented in verified written minutes.
          </p>
          <div class="safeguard-badge">
            <Icon name="check" size={14} class="text-green" />
            <span>Zero Undocumented Decisions</span>
          </div>
        </div>

        <!-- 4. Whistleblower Immunity -->
        <div class="safeguard-card card reveal-on-scroll delay-3">
          <div class="safeguard-icon-wrap icon-gold">
            <Icon name="shield" size={26} />
          </div>
          <div class="safeguard-header">
            <span class="safeguard-article">Chapter 12 &bull; Citizen Oversight</span>
            <h3>Whistleblower Protection</h3>
            <span class="urdu-safeguard-name urdu-text" dir="rtl">آزاد شکایات سیل اور مکمل تحفظ</span>
          </div>
          <p>
            Under Complaints Cell In-Charge Mr. Shafiq-ur-Rehman (0333-8303485), citizens reporting irregularities enjoy full identity confidentiality and zero-retaliation constitutional protection.
          </p>
          <div class="safeguard-badge">
            <Icon name="check" size={14} class="text-green" />
            <span>Anonymous Filing Enabled</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The 6 Core Public Transparency Registers -->
  <section class="section section-records" id="records-grid">
    <div class="container">
      <div class="section-header text-center">
        <Badge variant="gold">Public Records Portal</Badge>
        <h2 class="section-title">Official Registers &amp; Scrutiny Archives</h2>
        <p class="section-subtitle urdu-text" dir="rtl">
          عوام کی عدالت میں کھلے رجسٹر — آئین، قراردادیں، منصوبے، اخراجات اور سرکاری اعلانات کی تفصیلی دستاویزات
        </p>
      </div>

      <div class="transparency-grid">
        <!-- 1. The Constitution -->
        <div class="card trans-card card-highlight reveal-on-scroll">
          <div class="trans-card-top">
            <div class="trans-icon icon-green">
              <Icon name="document" size={30} />
            </div>
            <span class="trans-code-badge">CODIFIED LAW</span>
          </div>
          
          <div class="trans-title-group">
            <h3>Constitution &amp; By-Laws</h3>
            <span class="urdu-trans-title urdu-text" dir="rtl">کمیٹی کا مکمل 18 ابواب پر مشتمل آئین</span>
          </div>

          <p class="trans-desc">
            The foundational charter governing executive powers, general body consensus, 2-year terms, Shamilat land protection, and impeachment rules.
          </p>

          <ul class="trans-features-list">
            <li><Icon name="check" size={14} class="text-green" /> 18 codified constitutional chapters</li>
            <li><Icon name="check" size={14} class="text-green" /> Anti-defection &amp; code of conduct</li>
            <li><Icon name="check" size={14} class="text-green" /> 50%+1 democratic voting quorum</li>
          </ul>

          <div class="trans-card-footer">
            <Button variant="primary" size="sm" href="/transparency/constitution">
              <span>Read Full Constitution</span>
              <Icon name="arrow-right" size={14} />
            </Button>
          </div>
        </div>

        <!-- 2. Resolutions Register -->
        <div class="card trans-card reveal-on-scroll delay-1">
          <div class="trans-card-top">
            <div class="trans-icon icon-gold">
              <Icon name="shield" size={30} />
            </div>
            <span class="trans-code-badge">ACTION LOG</span>
          </div>

          <div class="trans-title-group">
            <h3>Resolutions Register</h3>
            <span class="urdu-trans-title urdu-text" dir="rtl">قراردادوں کا باضابطہ پبلک رجسٹر</span>
          </div>

          <p class="trans-desc">
            Every community initiative follows a numbered legislative chain: Problem &rarr; Proposal &rarr; Democratic Decision &rarr; Target Deadline &rarr; Assigned Officer.
          </p>

          <ul class="trans-features-list">
            <li><Icon name="check" size={14} class="text-green" /> Official resolution sequence numbers</li>
            <li><Icon name="check" size={14} class="text-green" /> Deadlines &amp; assigned council leads</li>
            <li><Icon name="check" size={14} class="text-green" /> Public execution logs &amp; minutes</li>
          </ul>

          <div class="trans-card-footer">
            <Button variant="primary" size="sm" href="/transparency/resolutions">
              <span>Browse Resolutions</span>
              <Icon name="arrow-right" size={14} />
            </Button>
          </div>
        </div>

        <!-- 3. Projects Tracker -->
        <div class="card trans-card reveal-on-scroll delay-2">
          <div class="trans-card-top">
            <div class="trans-icon icon-green">
              <Icon name="mountains" size={30} />
            </div>
            <span class="trans-code-badge">DEVELOPMENT</span>
          </div>

          <div class="trans-title-group">
            <h3>Projects &amp; Budgets Tracker</h3>
            <span class="urdu-trans-title urdu-text" dir="rtl">عوامی ترقیاتی منصوبوں کی مانیٹرنگ</span>
          </div>

          <p class="trans-desc">
            Live milestone tracking, verified budget breakdowns, contractor allocations, and completion reports for water pipelines, youth grounds, and civic upgrades.
          </p>

          <ul class="trans-features-list">
            <li><Icon name="check" size={14} class="text-green" /> Real-time progress percentages</li>
            <li><Icon name="check" size={14} class="text-green" /> PKR budget allocations &amp; spendings</li>
            <li><Icon name="check" size={14} class="text-green" /> Verified completion audit reports</li>
          </ul>

          <div class="trans-card-footer">
            <Button variant="primary" size="sm" href="/transparency/projects">
              <span>Track Active Projects</span>
              <Icon name="arrow-right" size={14} />
            </Button>
          </div>
        </div>

        <!-- 4. Financial Reports -->
        <div class="card trans-card card-highlight reveal-on-scroll">
          <div class="trans-card-top">
            <div class="trans-icon icon-gold">
              <Icon name="balance" size={30} />
            </div>
            <span class="trans-code-badge">AUDITED FINANCES</span>
          </div>

          <div class="trans-title-group">
            <h3>Financial Reports &amp; Ledger</h3>
            <span class="urdu-trans-title urdu-text" dir="rtl">مالیاتی حسابات و آڈٹ شدہ واؤچرز</span>
          </div>

          <p class="trans-desc">
            Supervised by Finance Secretary Waheed-ur-Rehman. Verified Easypaisa account details, dual signatures, and complete prohibition of unrecorded cash.
          </p>

          <ul class="trans-features-list">
            <li><Icon name="check" size={14} class="text-green" /> Official Easypaisa: 0334 8441095</li>
            <li><Icon name="check" size={14} class="text-green" /> Dual-signed expenditure ledger</li>
            <li><Icon name="check" size={14} class="text-green" /> Monthly income/expense statements</li>
          </ul>

          <div class="trans-card-footer">
            <Button variant="primary" size="sm" href="/transparency/finances">
              <span>Inspect Financial Ledger</span>
              <Icon name="arrow-right" size={14} />
            </Button>
          </div>
        </div>

        <!-- 5. Statements Archive -->
        <div class="card trans-card reveal-on-scroll delay-1">
          <div class="trans-card-top">
            <div class="trans-icon icon-green">
              <Icon name="document" size={30} />
            </div>
            <span class="trans-code-badge">OFFICIAL MEDIA</span>
          </div>

          <div class="trans-title-group">
            <h3>Official Statements Archive</h3>
            <span class="urdu-trans-title urdu-text" dir="rtl">سرکاری پریس بیانات اور اعلانات</span>
          </div>

          <p class="trans-desc">
            Certified declarations, press communiqués, and administrative announcements authorized under Chapter 13 official media and spokesperson protocol.
          </p>

          <ul class="trans-features-list">
            <li><Icon name="check" size={14} class="text-green" /> Authorized press releases only</li>
            <li><Icon name="check" size={14} class="text-green" /> Digital archive of civic alerts</li>
            <li><Icon name="check" size={14} class="text-green" /> Verified secretariat dispatch seals</li>
          </ul>

          <div class="trans-card-footer">
            <Button variant="primary" size="sm" href="/transparency/statements">
              <span>View Statements Archive</span>
              <Icon name="arrow-right" size={14} />
            </Button>
          </div>
        </div>

        <!-- 6. Whistleblower & Complaint System -->
        <div class="card trans-card card-highlight reveal-on-scroll delay-2">
          <div class="trans-card-top">
            <div class="trans-icon icon-gold">
              <Icon name="alert" size={30} />
            </div>
            <span class="trans-code-badge">INDEPENDENT CELL</span>
          </div>

          <div class="trans-title-group">
            <h3>Complaints &amp; Grievance Cell</h3>
            <span class="urdu-trans-title urdu-text" dir="rtl">شکایات سیل برائے عوامی احتساب</span>
          </div>

          <p class="trans-desc">
            In-Charge Mr. Shafiq-ur-Rehman (0333-8303485). Full citizen protection against retribution. File complaints against any member or local issue with optional anonymity.
          </p>

          <ul class="trans-features-list">
            <li><Icon name="check" size={14} class="text-green" /> Direct cell hotline: 0333-8303485</li>
            <li><Icon name="check" size={14} class="text-green" /> EXIF metadata auto-stripping</li>
            <li><Icon name="check" size={14} class="text-green" /> 100% confidential anonymous mode</li>
          </ul>

          <div class="trans-card-footer">
            <Button variant="accent" size="sm" href="/complaints">
              <span>Submit Issue / شکایت درج کریں</span>
              <Icon name="arrow-right" size={14} />
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Snapshot Section: Recent Resolutions & Active Projects -->
  <section class="section section-live-snapshot">
    <div class="container">
      <div class="section-header text-center">
        <Badge variant="green">Live Transparency Feed</Badge>
        <h2 class="section-title">Recent Resolutions &amp; Development Progress</h2>
        <p class="section-subtitle urdu-text" dir="rtl">
          کمیٹی کے تازہ ترین منظور شدہ فیصلے اور دیہہ میں جاری منصوبوں کی لمحہ بہ لمحہ پیش رفت
        </p>
      </div>

      <div class="snapshot-columns-grid">
        <!-- Column 1: Recent Resolutions -->
        <div class="snapshot-column">
          <div class="snapshot-col-header">
            <div class="snapshot-header-title">
              <Icon name="shield" size={20} class="text-green" />
              <h3>Approved Council Resolutions</h3>
            </div>
            <a href="/transparency/resolutions" class="view-all-link">
              <span>View All</span>
              <Icon name="arrow-right" size={12} />
            </a>
          </div>

          <div class="snapshot-cards-stack">
            {publicResolutions.map((res) => (
              <a href={`/transparency/resolutions/${res.id}`} class="snapshot-card card">
                <div class="snapshot-card-top">
                  <span class="res-num-tag">Res #{res.data.resolutionNo}</span>
                  <span class={`status-pill status-${res.data.status.toLowerCase().replace(/\s+/g, '-')}`}>
                    {res.data.status}
                  </span>
                </div>
                <h4 class="snapshot-card-title">{res.data.subject}</h4>
                <div class="snapshot-card-meta">
                  <span><Icon name="calendar" size={12} /> {new Date(res.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                  <span>&bull;</span>
                  <span><Icon name="users" size={12} /> {res.data.responsible}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Column 2: Active Development Projects -->
        <div class="snapshot-column">
          <div class="snapshot-col-header">
            <div class="snapshot-header-title">
              <Icon name="mountains" size={20} class="text-green" />
              <h3>Tracked Development Projects</h3>
            </div>
            <a href="/transparency/projects" class="view-all-link">
              <span>View All</span>
              <Icon name="arrow-right" size={12} />
            </a>
          </div>

          <div class="snapshot-cards-stack">
            {activeProjects.map((proj) => (
              <a href={`/transparency/projects/${proj.id}`} class="snapshot-card card">
                <div class="snapshot-card-top">
                  <span class="res-num-tag">{proj.data.category}</span>
                  <span class="budget-tag">{proj.data.budget}</span>
                </div>
                <h4 class="snapshot-card-title">{proj.data.title}</h4>
                
                <!-- Progress Bar -->
                <div class="project-mini-progress">
                  <div class="progress-info-row">
                    <span>Progress</span>
                    <strong>{proj.data.progress}%</strong>
                  </div>
                  <div class="progress-track">
                    <div class="progress-fill" style={`width: ${proj.data.progress}%;`}></div>
                  </div>
                </div>

                <div class="snapshot-card-meta">
                  <span><Icon name="users" size={12} /> {proj.data.responsible}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Official Financial Governance & Verified Details Callout -->
  <section class="section section-fin-highlight">
    <div class="container">
      <div class="finance-governance-box card">
        <div class="fin-box-grid">
          <!-- Left Info Column -->
          <div class="fin-info-col">
            <div class="fin-badge-row">
              <span class="fin-security-badge">
                <Icon name="shield" size={16} class="text-gold" />
                <span>Verified Financial Governance</span>
              </span>
              <span class="fin-chapter-tag">Chapter 8 Enforced</span>
            </div>

            <h3 class="fin-box-heading">Official Easypaisa &amp; Donation Channel</h3>
            <span class="urdu-fin-heading urdu-text" dir="rtl">توغ امن کمیٹی کا مستند مالیاتی نظام اور سرکاری اکاؤنٹ</span>

            <p class="fin-box-desc">
              All community contributions and welfare donations are received strictly through the authorized account of the Finance Secretary. 
              Personal accounts or unrecorded hand-to-hand collections are strictly illegal under committee constitution.
            </p>

            <div class="fin-account-card">
              <div class="account-header">
                <div class="account-type-badge">Official Easypaisa Account</div>
                <span class="account-status">Active &amp; Audited</span>
              </div>
              <div class="account-body">
                <div class="account-holder">
                  <span class="label">Designated Officer:</span>
                  <strong>Waheed-ur-Rehman (Finance Secretary)</strong>
                </div>
                <div class="account-number-row">
                  <span class="label">Easypaisa Number:</span>
                  <span class="account-digits">0334 8441095</span>
                </div>
              </div>
              <div class="account-footer">
                <Icon name="check" size={14} class="text-green" />
                <span>Always demand a counter-signed receipt for every donation.</span>
              </div>
            </div>
          </div>

          <!-- Right Verification & Secretariat Column -->
          <div class="fin-secretariat-col">
            <div class="secretariat-card">
              <h4 class="sec-title">Official Committee Secretariat</h4>
              <span class="urdu-sec-title urdu-text" dir="rtl">مرکزی سیکرٹریٹ و رابطہ مرکز</span>

              <div class="sec-item">
                <Icon name="map-pin" size={18} class="text-green" />
                <div>
                  <strong>Physical Address:</strong>
                  <p>Haji Rafiullah Khan Marhoom Market, Main Pindi Road, Kohat (Near National Bank of Pakistan)</p>
                </div>
              </div>

              <div class="sec-item">
                <Icon name="phone" size={18} class="text-green" />
                <div>
                  <strong>Official Hotlines:</strong>
                  <div class="hotline-numbers">
                    <a href="tel:+923339768022">+92 333 9768022</a>
                    <a href="tel:+923339636226">+92 333 9636226</a>
                    <a href="tel:+923369498887">+92 336 9498887</a>
                  </div>
                </div>
              </div>

              <div class="sec-item">
                <Icon name="alert" size={18} class="text-gold" />
                <div>
                  <strong>Complaints Cell In-Charge:</strong>
                  <p>Mr. Shafiq-ur-Rehman &bull; <a href="tel:03338303485" class="cell-phone">0333-8303485</a></p>
                </div>
