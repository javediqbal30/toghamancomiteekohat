<script>
  function setupTransHeroInteractive() {
    const hero = document.getElementById('trans-hero');
    if (!hero) return;

    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      hero.style.setProperty('--mouse-x', `${x}px`);
      hero.style.setProperty('--mouse-y', `${y}px`);
    });

    hero.addEventListener('mouseleave', () => {
      hero.style.setProperty('--mouse-x', '50%');
      hero.style.setProperty('--mouse-y', '50%');
    });
  }

  setupTransHeroInteractive();
  document.addEventListener('astro:page-load', setupTransHeroInteractive);
</script>
