---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import Icon from '../../../components/ui/Icon.astro';
import { FINANCE_SECRETARY } from '../../../data/contactInfo';

const monthlyReports = [
  {
    period: 'September 2026',
    title: 'Monthly Financial Audit & Vouchers Dossier',
    income: 'PKR 450,000',
    expense: 'PKR 285,400',
    balance: 'PKR 164,600',
    vouchersCount: 14,
    status: 'Executive Ratified',
    date: '30 Sep 2026',
    isSample: true
  },
  {
    period: 'August 2026',
    title: 'Inaugural Financial Summary & Opening Receipts',
    income: 'PKR 320,000',
    expense: 'PKR 91,400',
    balance: 'PKR 228,600',
    vouchersCount: 9,
    status: 'Executive Ratified',
    date: '31 Aug 2026',
    isSample: true
  }
];

const categoryExpenses = [
  { name: 'Water & Infrastructure (Resolution 05/2026)', percentage: 55, amount: 'PKR 285,000', color: 'var(--color-primary)' },
  { name: 'Youth Sports & Facilities (Resolution 02/2026)', percentage: 22, amount: 'PKR 91,400', color: 'var(--color-green)' },
  { name: 'Legal Counsel & Survey Retainers (Resolution 03/2026)', percentage: 15, amount: 'PKR 65,000', color: 'var(--color-gold)' },
  { name: 'Secretariat Office & Stationary', percentage: 8, amount: 'PKR 35,000', color: '#6B7280' }
];
---

<BaseLayout
  title="Financial Reports & Audits | Togh Aman"
  description="Inspect audited monthly and quarterly donation ledgers, expense vouchers, and verified public balance sheets of the Togh Aman Committee."
>
  <section class="page-header">
    <div class="container text-center">
      <Badge variant="gold">Chapter 8 Constitutional Mandate</Badge>
      <h1 class="page-title">Financial Transparency & Audits</h1>
      <p class="page-subtitle">
        "No money will be received or spent without a record, a numbered receipt, and an approved resolution."
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <!-- 1. The Core 9 Financial Laws Box -->
      <div class="card card-gold-accent fin-rules-card reveal-on-scroll">
        <div class="fin-rules-header">
          <Icon name="balance" size={28} class="text-gold" />
          <div>
            <h3>The Nine Rules of Financial Integrity</h3>
            <p>Enacted in Chapter 8 of the Constitution to protect community contributions from misuse or personal diversion.</p>
          </div>
        </div>

        <div class="nine-rules-grid">
          <div class="rule-box"><span>1</span> Verified record of all income</div>
          <div class="rule-box"><span>2</span> Verified record of all expenditure</div>
          <div class="rule-box"><span>3</span> Compulsory numbered receipts</div>
          <div class="rule-box"><span>4</span> Mandatory expense vouchers</div>
          <div class="rule-box"><span>5</span> Bank transactions prioritized</div>
          <div class="rule-box highlight-rule"><span>6</span> <strong>Personal accounts prohibited</strong></div>
          <div class="rule-box"><span>7</span> Monthly & quarterly public reports</div>
          <div class="rule-box"><span>8</span> Annual audit of accounts</div>
          <div class="rule-box"><span>9</span> Prior resolution approval for expenses</div>
        </div>
      </div>

      <!-- Finance Secretary & Official Easypaisa Card -->
      <div class="card card-gold-accent finance-secretary-card reveal-on-scroll">
        <div class="fin-sec-grid">
          <div class="fin-sec-photo-col">
            <div class="fin-sec-img-wrap">
              <img 
                src="/assets/leaders/Waheed_ur_Rehman.webp" 
                alt="Waheed-ur-Rehman - Finance Secretary" 
                class="fin-sec-img"
                width="280"
                height="280"
                loading="eager"
              />
            </div>
            <div class="fin-sec-badge-box">
              <Badge variant="green">Finance Secretary</Badge>
              <span class="fin-sec-urdu" dir="rtl">فنانس سیکریٹری</span>
            </div>
          </div>

          <div class="fin-sec-details-col">
            <div class="sec-meta-row">
              <span class="sec-tag">Official Treasury Custodian</span>
              <span class="sec-entity">TOOGH AMAN COMMITTEE</span>
            </div>

            <h2 class="sec-name">Waheed-ur-Rehman</h2>
            <p class="sec-subtitle">Finance Secretary &bull; Custodian of Chapter 8 Public Trust Ledger</p>

            <p class="sec-desc">
              All community donations, village contributions, and public welfare development funds are administered under strict constitutional protocols. Every payment received is immediately acknowledged with an official numbered receipt and ledger entry.
            </p>

            <!-- Easypaisa Verified Account Banner -->
            <div class="easypaisa-official-box">
              <div class="ep-info-main">
                <div class="ep-logo-title">
                  <span class="ep-brand-tag">Official Mobile Banking</span>
                  <span class="ep-acc-title">Easypaisa Account Number</span>
                </div>
                <strong class="ep-digits">0334 8441095</strong>
                <span class="ep-title-name">Account Title: <strong>TOOGH AMAN COMMITTEE</strong></span>
              </div>
              <div class="ep-actions-group">
                <a href="tel:03348441095" class="ep-btn call-ep-btn" title="Call Finance Secretary">
                  <Icon name="phone" size={15} />
                  <span>Call 0334 8441095</span>
                </a>
                <a 
                  href={FINANCE_SECRETARY.whatsappUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="ep-btn wa-ep-btn"
                  title="WhatsApp Finance Secretary"
                >
                  <Icon name="whatsapp" size={15} />
                  <span>WhatsApp Receipt</span>
                </a>
              </div>
            </div>

            <div class="sec-policy-foot">
              <Icon name="shield" size={16} class="text-green" />
              <span>Strict Rule (Chapter 8, Art. 24): Always demand a stamped numbered receipt for any cash or digital Easypaisa transfer.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Financial Overview Metrics -->
      <div class="stats-overview-grid">
        <div class="card stat-card reveal-on-scroll">
          <span class="stat-label">Total Verified Income</span>
          <strong class="stat-number">PKR 770,000</strong>
          <span class="stat-sub">Across 42 Numbered Receipts <Badge variant="neutral" size="sm">SAMPLE</Badge></span>
        </div>

        <div class="card stat-card reveal-on-scroll delay-1">
          <span class="stat-label">Verified Disbursements</span>
          <strong class="stat-number">PKR 376,800</strong>
          <span class="stat-sub">Backed by 23 Signed Vouchers <Badge variant="neutral" size="sm">SAMPLE</Badge></span>
        </div>

        <div class="card stat-card reveal-on-scroll delay-2">
          <span class="stat-label">Current Bank Reserve</span>
          <strong class="stat-number text-green">PKR 393,200</strong>
          <span class="stat-sub">Official Committee Trust Account <Badge variant="neutral" size="sm">SAMPLE</Badge></span>
        </div>
      </div>

      <!-- 3. Category Spending Breakdown (CSS / SVG Charts) -->
      <div class="card chart-breakdown-card reveal-on-scroll">
        <div class="chart-header">
          <h3>Expenditure Breakdown by Approved Resolution</h3>
          <p>Distribution of community funds across public welfare projects.</p>
        </div>

        <div class="bars-container">
          {categoryExpenses.map((cat) => (
            <div class="expense-bar-item">
              <div class="bar-info-row">
                <span class="bar-title">{cat.name}</span>
                <span class="bar-amount">{cat.amount} (<strong>{cat.percentage}%</strong>)</span>
              </div>
              <div class="bar-track">
                <div class="bar-fill" style={`width: ${cat.percentage}%; background-color: ${cat.color};`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 4. Monthly Verified Financial Statements & PDF Dossiers -->
      <div class="reports-dossier-wrap">
        <div class="section-title-wrap reveal-on-scroll">
          <Badge variant="green">Audited Statements</Badge>
          <h2>Monthly Financial Dossiers</h2>
          <p class="section-subtitle">
            Every statement is prepared by the Finance Secretary, certified with vouchers, and signed by the President.
          </p>
        </div>

        <div class="reports-table-card card">
          <div class="table-responsive">
            <table class="fin-table">
              <thead>
                <tr>
                  <th>Period</th>
                  <th>Statement Title</th>
                  <th>Income</th>
                  <th>Disbursements</th>
                  <th>Balance</th>
                  <th>Audit Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                {monthlyReports.map((rep) => (
                  <tr>
                    <td><strong>{rep.period}</strong></td>
                    <td>
                      {rep.title}
                      {rep.isSample && <Badge variant="neutral" size="sm" class="ml-2">SAMPLE</Badge>}
                    </td>
                    <td><span class="income-text">{rep.income}</span></td>
                    <td><span class="expense-text">{rep.expense}</span></td>
                    <td><strong class="balance-text">{rep.balance}</strong></td>
                    <td><Badge variant="success" size="sm">{rep.status}</Badge></td>
                    <td>
                      <Button variant="outline" size="sm" href="#" onclick="alert('Demo notice: In production, this downloads the official signed PDF audit report with scanned vouchers.'); return false;">
                        <Icon name="document" size={14} />
                        <span>Download PDF</span>
                      </Button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(180deg, var(--color-surface-subtle) 0%, var(--color-background) 100%);
    padding: var(--space-12) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .page-title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 680px;
    margin: 0 auto;
  }

  .fin-rules-card {
    padding: var(--space-8);
    margin-bottom: var(--space-10);
  }

  .fin-rules-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .fin-rules-header h3 {
    font-size: var(--text-xl);
    color: var(--color-primary);
    margin-bottom: 2px;
  }

  .fin-rules-header p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .nine-rules-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .nine-rules-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .nine-rules-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .rule-box {
    background: var(--color-surface-subtle);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    font-size: var(--text-xs);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .rule-box span {
    width: 22px;
    height: 22px;
    background: var(--color-primary);
    color: var(--color-white);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 11px;
    flex-shrink: 0;
  }

  .highlight-rule {
    background: rgba(212, 160, 23, 0.12);
    border-color: var(--color-gold);
  }

  .highlight-rule span {
    background: var(--color-gold-dark);
  }

  /* Finance Secretary Card */
  .finance-secretary-card {
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
    padding: var(--space-8);
  }

  .fin-sec-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 860px) {
    .fin-sec-grid {
      grid-template-columns: 260px 1fr;
      gap: var(--space-8);
    }
  }

  .fin-sec-photo-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .fin-sec-img-wrap {
    width: 100%;
    max-width: 250px;
    height: 270px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 3px solid var(--color-surface-subtle);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  .fin-sec-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .fin-sec-badge-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .fin-sec-urdu {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-primary);
  }

  .sec-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .sec-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold-dark);
  }

  .sec-entity {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.05em;
  }

  .sec-name {
    font-size: var(--text-2xl);
    color: var(--color-primary);
    margin-bottom: 2px;
  }

  .sec-subtitle {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-green);
    margin-bottom: var(--space-3);
  }

  .sec-desc {
    font-size: var(--text-sm);
    color: var(--color-text-main);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  /* Easypaisa Box */
  .easypaisa-official-box {
    background: #EBF8EE;
    border: 2px solid #25D366;
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .ep-info-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ep-logo-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .ep-brand-tag {
    background: #25D366;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.04em;
  }

  .ep-acc-title {
    font-size: 11px;
    font-weight: 700;
    color: #1B5E20;
    text-transform: uppercase;
  }

  .ep-digits {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: #064D32;
    letter-spacing: 0.05em;
  }

  .ep-title-name {
    font-size: 12px;
    color: #2E7D32;
  }

  .ep-actions-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .ep-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--duration-fast);
  }

  .call-ep-btn {
    background: #FFFFFF;
    color: var(--color-primary);
    border: 1px solid var(--color-border);
  }

  .call-ep-btn:hover {
    background: var(--color-primary);
    color: #FFFFFF;
  }

  .wa-ep-btn {
    background: #25D366;
    color: #FFFFFF;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
  }

  .wa-ep-btn:hover {
    background: #1EBE5B;
    transform: translateY(-1px);
  }

  .sec-policy-foot {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 12px;
    color: var(--color-text-subtle);
  }

  /* Stats overview */
  .stats-overview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 768px) {
    .stats-overview-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stat-card {
    padding: var(--space-6);
    text-align: center;
    border-top: 3px solid var(--color-primary);
  }

  .stat-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: var(--space-2);
  }

  .stat-number {
    font-size: var(--text-3xl);
    color: var(--color-primary);
    display: block;
    line-height: 1;
    margin-bottom: var(--space-2);
    font-family: monospace;
  }

  .stat-sub {
    font-size: 11px;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .text-green { color: var(--color-green); }

  /* Bars Breakdown */
  .chart-breakdown-card {
    padding: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .chart-header {
    margin-bottom: var(--space-6);
  }

  .chart-header h3 {
    font-size: var(--text-xl);
    color: var(--color-primary);
    margin-bottom: 2px;
  }

  .chart-header p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .bars-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .expense-bar-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .bar-info-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
  }

  .bar-title {
    font-weight: 600;
    color: var(--color-text);
  }

  .bar-amount {
    color: var(--color-text-muted);
  }

  .bar-track {
    width: 100%;
    height: 8px;
    background: var(--color-surface-subtle);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    border-radius: var(--radius-full);
  }

  /* Table */
  .reports-table-card {
    padding: 0;
    overflow: hidden;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .fin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .fin-table th, .fin-table td {
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }

  .fin-table th {
    background: var(--color-primary);
    color: var(--color-white);
    font-weight: 600;
  }

  .income-text {
    color: var(--color-green);
    font-weight: 600;
  }

  .expense-text {
    color: var(--color-danger);
    font-weight: 600;
  }

  .balance-text {
    color: var(--color-primary);
  }

  .ml-2 { margin-left: var(--space-2); }
  .text-center { text-align: center; }
</style>
