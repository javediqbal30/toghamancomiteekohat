---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
---

<BaseLayout 
  title="Youth, Sports & Vigilance Wing | Togh Aman Committee"
  description="Empowering the youth of Togh Bala & Payan through anti-narcotics campaigns, sports leagues, digital literacy, and civic peace advocacy."
>
  <!-- Interactive Hero Section with Mouse Spotlight & Floating Orbs -->
  <section class="youth-hero-section" id="youth-hero">
    <!-- 1. Interactive Mouse Spotlight Glow Layer -->
    <div class="hero-mouse-spotlight" id="hero-mouse-glow" aria-hidden="true"></div>

    <!-- 2. Geometric Dot Matrix Pattern -->
    <div class="hero-matrix-grid" aria-hidden="true"></div>

    <!-- 3. Rising Floating Glowing Orbs -->
    <div class="floating-orbs-layer" aria-hidden="true">
      <span class="rising-orb orb-1"></span>
      <span class="rising-orb orb-2"></span>
      <span class="rising-orb orb-3"></span>
      <span class="rising-orb orb-4"></span>
      <span class="rising-orb orb-5"></span>
      <span class="rising-orb orb-6"></span>
      <span class="rising-orb orb-7"></span>
      <span class="rising-orb orb-8"></span>
      <span class="rising-orb orb-9"></span>
      <span class="rising-orb orb-10"></span>
    </div>

    <!-- 4. Scenic Wave Contour Transition -->
    <div class="hero-wave-transition" aria-hidden="true">
      <svg viewBox="0 0 1440 140" fill="none" preserveAspectRatio="none" class="wave-svg">
        <path d="M0,140 L0,90 Q360,35 720,80 Q1080,125 1440,70 L1440,140 Z" fill="rgba(6, 77, 50, 0.04)" />
        <path d="M0,140 L0,110 Q360,70 720,105 Q1080,138 1440,95 L1440,140 Z" fill="rgba(212, 160, 23, 0.05)" />
      </svg>
    </div>

    <div class="container hero-content-container text-center">
      <div class="hero-badge-cluster">
        <Badge variant="gold">Pillar 7 &bull; Youth &amp; Sports Wing</Badge>
        <span class="hero-status-pill">
          <Icon name="shield" size={14} class="text-green" />
          <span>Anti-Narcotics &bull; منشیات کے خلاف نوجوانوں کا عزم</span>
        </span>
      </div>

      <h1 class="page-title">Youth, Sports &amp; Vigilance Wing</h1>
      <span class="urdu-hero-title urdu-text" dir="rtl">توغ یوتھ، اسپورٹس اور انسدادِ منشیات نگہبان ونگ</span>

      <div class="hero-quote-box">
        <p class="hero-quote-urdu urdu-text" dir="rtl">
          "نوجوان ہمارا کل نہیں بلکہ ہمارا آج ہیں — منشیات سے پاک توغ، صحت مند کھیل اور باکردار قیادت۔"
        </p>
        <p class="hero-quote-en">
          "Eradicating narcotics (ice/crystal meth), revitalizing village athletic grounds, and cultivating the next generation of peaceful leaders in Togh Bala &amp; Payan."
        </p>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="hero-metrics-strip">
        <div class="metric-pill">
          <strong class="metric-num">500+</strong>
          <span class="metric-txt">Active Athletes</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-pill">
          <strong class="metric-num">100%</strong>
          <span class="metric-txt">Anti-Ice Vigilance</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-pill">
          <strong class="metric-num">2</strong>
          <span class="metric-txt">Villages Unified</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-pill">
          <strong class="metric-num">0</strong>
          <span class="metric-txt">Drug Tolerance</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="hero-cta-group">
        <a href="#youth-form" class="btn-hero-explore">
          <span>Join Youth Volunteers</span>
          <Icon name="arrow-right" size={15} />
        </a>
        <Button variant="outline" size="md" href="/complaints">
          <Icon name="alert" size={16} />
          <span>Report Drug Issue / شکایت درج کریں</span>
        </Button>
      </div>
    </div>
  </section>

  <!-- Core Pillars of Youth Wing -->
  <section class="section-py bg-surface">
    <div class="container">
      <div class="cards-triad-grid">
        <!-- Anti-Narcotics Pillar -->
        <div class="wing-feature-card card reveal-on-scroll">
          <div class="feature-icon bg-red-soft">
            <Icon name="shield" size={24} class="text-danger" />
          </div>
          <div class="feature-header-wrap">
            <h2 class="card-title mt-3">Anti-Narcotics Vigilance</h2>
            <span class="urdu-card-title urdu-text" dir="rtl">منشیات اور آئس کی روک تھام</span>
          </div>
          <p class="card-desc">
            In coordinated partnership with DPO Kohat and local elders, the Youth Wing operates an active surveillance reporting network to eradicate the sale and distribution of ice, crystal meth, and illegal drugs in our villages.
          </p>
          <div class="card-footer mt-4">
            <Badge variant="danger">Zero Tolerance Policy</Badge>
          </div>
        </div>

        <!-- Sports Leagues Pillar -->
        <div class="wing-feature-card card reveal-on-scroll delay-1">
          <div class="feature-icon bg-green-soft">
            <Icon name="activity" size={24} class="text-green" />
          </div>
          <div class="feature-header-wrap">
            <h2 class="card-title mt-3">Annual Peace Sports Gala</h2>
            <span class="urdu-card-title urdu-text" dir="rtl">سالانہ امن اسپورٹس گالا و ٹورنامنٹس</span>
          </div>
          <p class="card-desc">
            Organizing inter-mohallah football, cricket, and volleyball tournaments across Togh Bala and Payan grounds to cultivate discipline, sportsmanship, and inter-clan brotherhood among 500+ participating athletes.
          </p>
          <div class="card-footer mt-4">
            <Badge variant="green">Annual Tournament Active</Badge>
          </div>
        </div>

        <!-- Digital Skills & Leadership -->
        <div class="wing-feature-card card reveal-on-scroll delay-2">
          <div class="feature-icon bg-gold-soft">
            <Icon name="users" size={24} class="text-gold" />
          </div>
          <div class="feature-header-wrap">
            <h2 class="card-title mt-3">Civic Peace Ambassadors</h2>
            <span class="urdu-card-title urdu-text" dir="rtl">نوجوان سفیرانِ امن اور قیادت</span>
          </div>
          <p class="card-desc">
            Training young high school and college graduates in conflict de-escalation, emergency first aid, digital literacy, and constitutional village governance so they can actively participate in Jirga deliberations.
          </p>
          <div class="card-footer mt-4">
            <Badge variant="gold">Leadership Fellowship</Badge>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Volunteer Registration Section -->
  <section class="section-py" id="youth-form">
    <div class="container max-w-2xl">
      <div class="form-header text-center mb-6">
        <Badge variant="gold">Volunteer Intake</Badge>
        <h2 class="form-section-title">Join the Youth Peace Volunteers</h2>
        <span class="urdu-form-title urdu-text" dir="rtl">توغ امن کمیٹی کے یوتھ امن رضاکار بنیں</span>
        <p class="form-section-sub">
          If you are between 16 and 35 years old residing in Togh Bala or Togh Payan, sign up to serve your village community.
        </p>
      </div>

      <form class="youth-volunteer-form card" id="volunteer-form">
        <div class="form-row">
          <div class="form-group">
            <label for="volunteer-name" class="input-label">Full Name / پورا نام</label>
            <input type="text" id="volunteer-name" required placeholder="e.g. Asad Khattak" class="form-input" />
          </div>
          <div class="form-group">
            <label for="volunteer-cnic" class="input-label">CNIC / B-Form Number / شناختی کارڈ</label>
            <input type="text" id="volunteer-cnic" required placeholder="14301-XXXXXXX-X" class="form-input" />
          </div>
        </div>

        <div class="form-row mt-4">
          <div class="form-group">
            <label for="volunteer-village" class="input-label">Village &amp; Mohallah / محلہ و دیہہ</label>
            <input type="text" id="volunteer-village" required placeholder="e.g. Togh Bala, Mohallah Khwaja Khel" class="form-input" />
          </div>
          <div class="form-group">
            <label for="volunteer-phone" class="input-label">Mobile Number / واٹس ایپ نمبر</label>
            <input type="tel" id="volunteer-phone" required placeholder="0333-XXXXXXX" class="form-input" />
          </div>
        </div>

        <div class="form-group mt-4">
          <label for="volunteer-interest" class="input-label">Area of Contribution / دلچسپی کا شعبہ</label>
          <select id="volunteer-interest" class="form-select">
            <option value="anti-drug">Anti-Narcotics Awareness &amp; Patrols (انسدادِ منشیات)</option>
            <option value="sports">Sports Ground Maintenance &amp; Tournament Organizing (کھیل و ٹورنامنٹ)</option>
            <option value="emergency">Emergency Flood &amp; Fire Rescue Squad (ایمرجنسی و ریسکیو)</option>
            <option value="education">Tuition &amp; Educational Tutoring (تعلیم و کوچنگ)</option>
          </select>
        </div>

        <div class="form-submit mt-6">
          <Button variant="accent" type="submit" class="w-full">
            <span>Register as Youth Peace Volunteer / رضاکار بنیں</span>
            <Icon name="arrow-right" size={16} />
          </Button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  /* Youth Hero Section with Interactive Spotlight & Rising Orbs */
  .youth-hero-section {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #F3F7F4 0%, #FFFFFF 100%);
    padding: var(--space-16) 0 var(--space-12);
    border-bottom: 1px solid var(--color-border);
    --mouse-x: 50%;
    --mouse-y: 50%;
  }

  /* Interactive Mouse Spotlight Glow */
  .hero-mouse-spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(
      520px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(212, 160, 23, 0.22),
      rgba(6, 77, 50, 0.12) 35%,
      transparent 70%
    );
    transition: background 0.08s ease-out;
  }

  /* Dot Matrix Pattern */
  .hero-matrix-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.55;
    background-image: radial-gradient(rgba(6, 77, 50, 0.15) 1.2px, transparent 1.2px);
    background-size: 26px 26px;
    mask-image: linear-gradient(180deg, #000 65%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 65%, transparent 100%);
  }

  /* Rising Floating Orbs Layer */
  .floating-orbs-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  .rising-orb {
    position: absolute;
    bottom: -30px;
    border-radius: 50%;
    pointer-events: none;
    animation: floatUpward linear infinite;
  }

  @keyframes floatUpward {
    0% {
      bottom: -30px;
      transform: translateX(0) scale(0.85);
      opacity: 0;
    }
    20% {
      opacity: 0.25;
    }
    50% {
      transform: translateX(18px) scale(1.05);
      opacity: 0.38;
    }
    80% {
      opacity: 0.22;
    }
    100% {
      bottom: 108%;
      transform: translateX(-16px) scale(1.1);
      opacity: 0;
    }
  }

  /* 10 Subtle Floating Glowing Particles */
  .orb-1 { width: 8px; height: 8px; left: 7%; background: radial-gradient(circle at 35% 35%, #81C784, #064D32); animation-duration: 9s; animation-delay: 0s; }
  .orb-2 { width: 12px; height: 12px; left: 19%; background: radial-gradient(circle at 35% 35%, #FDE047, #D4A017); animation-duration: 13s; animation-delay: 2s; }
  .orb-3 { width: 6px; height: 6px; left: 32%; background: radial-gradient(circle at 35% 35%, #A7F3D0, #047857); animation-duration: 8s; animation-delay: 4.5s; }
  .orb-4 { width: 10px; height: 10px; left: 45%; background: radial-gradient(circle at 35% 35%, #FCD34D, #B45309); animation-duration: 11s; animation-delay: 1.2s; }
  .orb-5 { width: 7px; height: 7px; left: 58%; background: radial-gradient(circle at 35% 35%, #6EE7B7, #065F46); animation-duration: 9.5s; animation-delay: 3.8s; }
  .orb-6 { width: 13px; height: 13px; left: 71%; background: radial-gradient(circle at 35% 35%, #FEF08A, #D97706); animation-duration: 14s; animation-delay: 5s; }
  .orb-7 { width: 8px; height: 8px; left: 83%; background: radial-gradient(circle at 35% 35%, #86EFAC, #15803D); animation-duration: 10s; animation-delay: 2.7s; }
  .orb-8 { width: 10px; height: 10px; left: 92%; background: radial-gradient(circle at 35% 35%, #FDE68A, #CA8A04); animation-duration: 12.5s; animation-delay: 4.1s; }
  .orb-9 { width: 7px; height: 7px; left: 14%; background: radial-gradient(circle at 35% 35%, #A7F3D0, #064D32); animation-duration: 8.5s; animation-delay: 6s; }
  .orb-10 { width: 9px; height: 9px; left: 52%; background: radial-gradient(circle at 35% 35%, #FDE047, #D4A017); animation-duration: 11.5s; animation-delay: 7s; }

  /* Wave Transition */
  .hero-wave-transition {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    pointer-events: none;
    z-index: 1;
    line-height: 0;
  }

  .wave-svg {
    width: 100%;
    height: 70px;
    display: block;
  }

  .hero-content-container {
    position: relative;
    z-index: 2;
    max-width: 960px;
  }

  .hero-badge-cluster {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: var(--space-4);
  }

  .hero-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(6, 77, 50, 0.08);
    color: var(--color-primary);
    padding: 4px 14px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid rgba(6, 77, 50, 0.15);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .urdu-hero-title {
    display: block;
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-weight: 700;
    color: var(--color-green);
    line-height: 1.8;
    margin-bottom: var(--space-4);
  }

  .hero-quote-box {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(6, 77, 50, 0.12);
    border-left: 4px solid var(--color-gold);
    border-right: 4px solid var(--color-green);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
    max-width: 780px;
    margin: 0 auto var(--space-6);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  }

  .hero-quote-urdu {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 6px;
    line-height: 1.8;
  }

  .hero-quote-en {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
    font-style: italic;
  }

  /* Metrics Strip */
  .hero-metrics-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    padding: 10px 24px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
    width: fit-content;
    margin: 0 auto var(--space-8);
  }

  .metric-pill {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .metric-num {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  .metric-txt {
    font-size: 12px;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .metric-divider {
    width: 1px;
    height: 18px;
    background: var(--color-border);
  }

  @media (max-width: 640px) {
    .hero-metrics-strip {
      border-radius: var(--radius-md);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      padding: 14px 18px;
      width: 100%;
    }
    .metric-divider {
      display: none;
    }
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }

  .btn-hero-explore {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(180deg, #D4A017 0%, #B8860B 100%);
    color: #123322;
    padding: 12px 24px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(212, 160, 23, 0.35);
    transition: all 0.2s ease;
  }

  .btn-hero-explore:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(212, 160, 23, 0.45);
    filter: brightness(1.05);
  }

  /* Core Triad Grid */
  .section-py {
    padding: var(--space-12) 0;
  }

  .bg-surface {
    background-color: var(--color-surface-subtle);
  }

  .cards-triad-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .cards-triad-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .wing-feature-card {
    background: var(--color-white);
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .wing-feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(6, 77, 50, 0.08);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bg-red-soft { background: rgba(220, 38, 38, 0.1); }
  .bg-green-soft { background: rgba(8, 116, 67, 0.1); }
  .bg-gold-soft { background: rgba(212, 160, 23, 0.15); }

  .text-danger { color: var(--color-danger); }
  .text-green { color: var(--color-green); }
  .text-gold { color: #8C6B00; }

  .feature-header-wrap {
    margin-top: var(--space-3);
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 2px;
  }

  .urdu-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-green);
    display: block;
    line-height: 1.5;
  }

  .card-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: var(--space-3) 0;
  }

  .card-footer {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid rgba(6, 77, 50, 0.08);
  }

  /* Form Section */
  .max-w-2xl {
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .form-section-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary);
    margin-top: var(--space-2);
    margin-bottom: 2px;
  }

  .urdu-form-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-green);
    line-height: 1.6;
    display: block;
    margin-bottom: var(--space-2);
  }

  .form-section-sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0 auto;
  }

  .youth-volunteer-form {
    background: var(--color-white);
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    box-shadow: 0 10px 30px rgba(6, 77, 50, 0.06);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .input-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
  }

  .form-input,
  .form-select {
    padding: 10px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-input:focus,
  .form-select:focus {
    outline: none;
    border-color: var(--color-green);
    box-shadow: 0 0 0 3px rgba(6, 77, 50, 0.12);
  }

  .text-center { text-align: center; }
  .mb-6 { margin-bottom: var(--space-6); }
  .mt-4 { margin-top: var(--space-4); }
  .mt-6 { margin-top: var(--space-6); }
  .w-full { width: 100%; }

  .urdu-text {
    font-family: 'Noto Nastaliq Urdu', 'Jameel Noori Nastaleeq', 'Urdu Typesetting', -apple-system, BlinkMacSystemFont, 'Segoe UI', Tahoma, sans-serif;
  }
</style>

<script>
  function setupYouthHeroInteractive() {
    const hero = document.getElementById('youth-hero');
    if (!hero) return;

    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      hero.style.setProperty('--mouse-x', `${x}px`);
      hero.style.setProperty('--mouse-y', `${y}px`);
    });

    hero.addEventListener('mouseleave', () => {
      hero.style.setProperty('--mouse-x', '50%');
      hero.style.setProperty('--mouse-y', '50%');
    });
  }

  function setupYouthForm() {
    const form = document.getElementById('volunteer-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('Alhamdulillah! Your youth volunteer registration has been received. The Youth Wing Coordinator will contact you.');
        (form as HTMLFormElement).reset();
      });
    }
  }

  setupYouthHeroInteractive();
  setupYouthForm();
  document.addEventListener('astro:page-load', () => {
    setupYouthHeroInteractive();
    setupYouthForm();
  });
</script>
