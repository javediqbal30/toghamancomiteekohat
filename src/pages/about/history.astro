  <!-- Interactive Language Switcher Script -->
  <script>
    function initManifestoLangSwitcher() {
      const switcher = document.getElementById('lang-switcher');
      const reader = document.getElementById('manifesto-reader');
      if (!switcher || !reader) return;

      const buttons = switcher.querySelectorAll<HTMLButtonElement>('.lang-btn');

      // Check saved preference or default to dual
      const savedLang = localStorage.getItem('manifesto_lang_preference') || 'dual';
      applyLang(savedLang);

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const lang = btn.dataset.lang || 'dual';
          applyLang(lang);
          localStorage.setItem('manifesto_lang_preference', lang);
        });
      });

      function applyLang(lang: string) {
        buttons.forEach(b => {
          const isActive = b.dataset.lang === lang;
          b.classList.toggle('active', isActive);
          b.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        // Set classes on reader
        reader.classList.remove('mode-dual', 'mode-en', 'mode-ur');
        reader.classList.add(`mode-${lang}`);
      }

      // Intersection Observer for active TOC links
      const chapters = document.querySelectorAll<HTMLElement>('.manifesto-chapter');
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            tocLinks.forEach(link => {
              const href = link.getAttribute('href');
              if (href === `#${id}`) {
                link.classList.add('active');
              } else {
                link.classList.remove('active');
              }
            });
          }
        });
      }, { rootMargin: '-20% 0px -70% 0px' });

      chapters.forEach(ch => observer.observe(ch));
    }

    document.addEventListener('astro:page-load', initManifestoLangSwitcher);
    initManifestoLangSwitcher();
  </script>
