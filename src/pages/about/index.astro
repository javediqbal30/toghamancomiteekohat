---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
---

<BaseLayout
  title="About Us | Togh Aman Committee"
  description="Learn about the origin, constitution, leadership, and democratic structure of the Togh Aman Committee serving Togh Bala & Payan."
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container text-center">
      <Badge variant="gold">Origins & Governance</Badge>
      <h1 class="page-title">About the Togh Aman Committee</h1>
      <p class="page-subtitle">
        A lawful, non-political, non-sectarian civic trust created by and for the people of Togh Bala & Payan.
      </p>
    </div>
  </section>

  <!-- Preamble & Sacred Principle -->
  <section class="section">
    <div class="container">
      <div class="card card-gold-accent preamble-card reveal-on-scroll">
        <span class="section-tag">Constitutional Preamble</span>
        <h2>The Foundation of Our Trust</h2>
        <p class="lead-text">
          "The Togh Public Committee will be a non-political, non-sectarian public welfare platform. 
          The Committee will not be used for the personal benefit of any person, family, or group. 
          The common good of the whole area will always come first."
        </p>
        <div class="principle-quote-box">
          <Icon name="balance" size={28} class="text-gold" />
          <blockquote>
            "The Togh Public Committee is not the property of any person. It is a trust of the people."
          </blockquote>
        </div>
        <p>
          All office holders and members of this Committee are not owners of power. 
          They are representatives who are answerable to the people under the rule of law, merit, joint consultation, written proof, and public interest.
        </p>
      </div>
    </div>
  </section>

  <!-- Historical Timeline -->
  <section class="section timeline-section" id="timeline">
    <div class="container">
      <div class="section-title-wrap text-center reveal-on-scroll">
        <Badge variant="green">Our Journey</Badge>
        <h2>Historical Milestones</h2>
        <p class="section-subtitle">
          How community consultation transformed into an institutional, constitution-bound committee.
        </p>
      </div>

      <div class="timeline-container">
        <!-- Milestone 1 -->
        <div class="timeline-item reveal-on-scroll">
          <div class="timeline-marker"></div>
          <div class="timeline-card card">
            <span class="timeline-date">July 2024</span>
            <h3>Foundation Laid</h3>
            <p>
              Founder <strong>Hadayatullah Khan</strong> initiated the peaceful public movement in Togh, uniting respected village elders to build a lawful platform protecting public rights and settling communal disputes.
            </p>
          </div>
        </div>

        <!-- Milestone 2 -->
        <div class="timeline-item reveal-on-scroll delay-1">
          <div class="timeline-marker"></div>
          <div class="timeline-card card">
            <span class="timeline-date">July 2026</span>
            <h3>Strengthened & Constitution Codified</h3>
            <p>
              The movement was formalized into an institutional framework with an 18-chapter Constitution, written rules of procedure, financial transparency protocols, and separation of administrative powers.
            </p>
          </div>
        </div>

        <!-- Milestone 3 -->
        <div class="timeline-item reveal-on-scroll delay-2">
          <div class="timeline-marker"></div>
          <div class="timeline-card card card-gold-accent">
            <span class="timeline-date">25 August 2026</span>
            <h3>Formal Public Opening</h3>
            <p>
              Formal inauguration of the committee secretariat under the presidency of <strong>Malik Ihsanullah</strong>, declaring zero tolerance against narcotics, crime, and land encroachment within the bounds of Pakistani law.
            </p>
          </div>
        </div>
      </div>

      <!-- Featured Bilingual Historical Manifesto Banner -->
      <div class="manifesto-feature-banner card card-gold-accent reveal-on-scroll mt-12">
        <div class="manifesto-banner-grid">
          <div class="manifesto-banner-content">
            <div class="manifesto-banner-badges">
              <Badge variant="gold">Official Historical Charter • باضابطہ تاریخی منشور</Badge>
              <span class="manifesto-chagha-pill">
                <Icon name="shield" size={13} class="text-green" />
                <span>From Qaumi Chagha to Peace Committee</span>
              </span>
            </div>
            <h3 class="manifesto-banner-title">
              A New Era of Collective Awakening &bull; <span class="urdu-text" dir="rtl">اجتماعی بیداری کا نیا دور</span>
            </h3>
            <p class="manifesto-banner-desc">
              Discover the full 14-chapter ideological journey of Togh Bala: from the ancient Pashtun tradition of <em>Qaumi Chagha</em>, through the fight against narcotics and land mafias, to the sacred oath taken upon the Holy Quran.
            </p>
            <div class="manifesto-banner-meta">
              <span><Icon name="document" size={13} /> 14 Chapters</span>
              <span>&bull;</span>
              <span><Icon name="check-circle" size={13} /> Unabridged Bilingual Edition (English + اردو)</span>
            </div>
          </div>
          <div class="manifesto-banner-cta">
            <Button variant="accent" size="lg" href="/about/history" class="w-full">
              <span>Read Full Bilingual Manifesto</span>
              <Icon name="arrow-right" size={16} />
            </Button>
            <span class="manifesto-cta-subtext urdu-text" dir="rtl">مکمل اردو و انگریزی متن مطالعہ فرمائیں</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership Detailed Section -->
  <section class="section leadership-full-section">
    <div class="container">
      <div class="section-title-wrap text-center reveal-on-scroll">
        <div class="leadership-badge-wrap">
          <Badge variant="gold">Executive Governance &bull; مجلسِ انتظامیہ</Badge>
          <span class="leadership-status-pill">
            <Icon name="shield" size={14} class="text-green" />
            <span>Constitutional Mandate &bull; باضابطہ عوامی احتساب</span>
          </span>
        </div>
        <h2 class="leadership-section-title">Custodian Leadership &amp; Administration</h2>
        <span class="urdu-leadership-title urdu-text" dir="rtl">قیادت و سرپرستان — توغ امن کمیٹی (توغ بالا و پایان)</span>
        <p class="section-subtitle">
          Bound by codified merit, collective consultation, and public accountability rather than unilateral personal authority.
        </p>
      </div>

      <div class="leaders-profile-grid">
        <!-- Founder Profile -->
        <div class="card leader-profile-card reveal-on-scroll">
          <div class="leader-card-top-bar">
            <Badge variant="gold">Founder &amp; Visionary</Badge>
            <span class="leader-role-urdu urdu-text" dir="rtl">بانی و محرک</span>
          </div>
          <div class="leader-photo-wrap">
            <img 
              src="/assets/leaders/hadayatullah-khan.webp" 
              alt="Hadayatullah Khan - Founder" 
              class="profile-img"
              loading="lazy"
            />
            <div class="photo-overlay-tag">
              <Icon name="shield" size={12} class="text-gold" />
              <span>Foundation: July 2024</span>
            </div>
          </div>
          <div class="profile-content">
            <div class="leader-name-block">
              <h3 class="leader-name">Hadayatullah Khan</h3>
              <span class="leader-name-urdu urdu-text" dir="rtl">ہدایت اللہ خان</span>
            </div>
            <span class="profile-tenure">
              <Icon name="calendar" size={12} />
              <span>Foundation: July 2024 &bull; Revival: July 2026</span>
            </span>
            <blockquote class="leader-quote">
              "The strength of Togh lies in its people and our shared heritage. The Committee exists so our youth have jobs and sports rather than narcotics, our shared lands remain unviolated, and grievances are resolved with dignity."
            </blockquote>
            <div class="profile-card-footer">
              <a href="/about/history" class="leader-card-action-btn">
                <Icon name="arrow-right" size={14} />
                <span>Read Historical Manifesto</span>
              </a>
            </div>
          </div>
        </div>

        <!-- President Profile -->
        <div class="card leader-profile-card reveal-on-scroll delay-1">
          <div class="leader-card-top-bar">
            <Badge variant="green">President</Badge>
            <span class="leader-role-urdu urdu-text" dir="rtl">صدرِ کمیٹی</span>
          </div>
          <div class="leader-photo-wrap">
            <img 
              src="/assets/leaders/malik-ihsanullah.webp" 
              alt="Malik Ihsanullah - President" 
              class="profile-img"
              loading="lazy"
            />
            <div class="photo-overlay-tag">
              <Icon name="balance" size={12} class="text-gold" />
              <span>Inaugural Term &bull; 2026</span>
            </div>
          </div>
          <div class="profile-content">
            <div class="leader-name-block">
              <h3 class="leader-name">Malik Ihsanullah</h3>
              <span class="leader-name-urdu urdu-text" dir="rtl">ملک احسان اللہ</span>
            </div>
            <span class="profile-tenure">
              <Icon name="calendar" size={12} />
              <span>Elected Tenure &bull; Opened: 25 August 2026</span>
            </span>
            <blockquote class="leader-quote">
              "Under Chapter 5 of our constitution, the President holds zero power to make unilateral decisions. Every action is bound to written quorum resolutions, standing firmly with the law against crime and narcotics."
            </blockquote>
            <div class="profile-card-footer">
              <a href="/transparency/constitution#ch5" class="leader-card-action-btn">
                <Icon name="document" size={14} />
                <span>Chapter 5: Powers &amp; Quorum</span>
              </a>
            </div>
          </div>
        </div>

        <!-- In-Charge Complaints Cell Profile -->
        <div class="card leader-profile-card reveal-on-scroll delay-2">
          <div class="leader-card-top-bar">
            <Badge variant="gold">In-Charge Complaints</Badge>
            <span class="leader-role-urdu urdu-text" dir="rtl">انچارج شکایات سیل</span>
          </div>
          <div class="leader-photo-wrap">
            <img 
              src="/assets/leaders/Mr_Shafiq_ur_Rehman.webp" 
              alt="Mr. Shafiq-ur-Rehman - In-Charge Complaints Cell" 
              class="profile-img"
              loading="lazy"
            />
            <div class="photo-overlay-tag">
              <Icon name="phone" size={12} class="text-gold" />
              <span>Hotline: 0333-8303485</span>
            </div>
          </div>
          <div class="profile-content">
            <div class="leader-name-block">
              <h3 class="leader-name">Mr. Shafiq-ur-Rehman</h3>
              <span class="leader-name-urdu urdu-text" dir="rtl">شفیق الرحمن</span>
            </div>
            <span class="profile-tenure">
              <Icon name="shield" size={12} />
              <span>Grievance &amp; Citizen Cell &bull; Confidentiality</span>
            </span>
            <blockquote class="leader-quote">
              "If any citizen faces an issue, particularly concerning any member of the Aman Committee, contact me directly. All complaints are heard respectfully, logged in the register, and reviewed with zero retaliation."
            </blockquote>
            <div class="profile-card-footer">
              <div class="leader-dual-actions">
                <a href="tel:03338303485" class="leader-sub-btn call-sub-btn" aria-label="Call Complaints In-Charge">
                  <Icon name="phone" size={13} />
                  <span>0333-8303485</span>
                </a>
                <a href="https://wa.me/923338303485?text=Peace%20be%20upon%20you%20Mr.%20Shafiq-ur-Rehman,%20I%20have%20a%20grievance%20for%20the%20Complaints%20Cell." target="_blank" rel="noopener noreferrer" class="leader-sub-btn wa-sub-btn" aria-label="WhatsApp Complaints In-Charge">
                  <Icon name="whatsapp" size={13} />
                  <span>WhatsApp</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Finance Secretary Profile -->
        <div class="card leader-profile-card reveal-on-scroll delay-3">
          <div class="leader-card-top-bar">
            <Badge variant="green">Finance Secretary</Badge>
            <span class="leader-role-urdu urdu-text" dir="rtl">ناظمِ مالیات و خزانچی</span>
          </div>
          <div class="leader-photo-wrap">
            <img 
              src="/assets/leaders/Waheed_ur_Rehman.webp" 
              alt="Waheed-ur-Rehman - Finance Secretary" 
              class="profile-img"
              loading="lazy"
            />
            <div class="photo-overlay-tag">
              <Icon name="lock" size={12} class="text-gold" />
              <span>Easypaisa: 0334 8441095</span>
            </div>
          </div>
          <div class="profile-content">
            <div class="leader-name-block">
              <h3 class="leader-name">Waheed-ur-Rehman</h3>
              <span class="leader-name-urdu urdu-text" dir="rtl">وحید الرحمن</span>
            </div>
            <span class="profile-tenure">
              <Icon name="balance" size={12} />
              <span>Treasury Custodian &bull; 100% Audited Ledgers</span>
            </span>
            <blockquote class="leader-quote">
              "Under Chapter 8 of our Constitution, financial management is bound to public accountability. Zero personal accounts, numbered receipts for every donation, and dual-authorization on all disbursements."
            </blockquote>
            <div class="profile-card-footer">
              <div class="leader-dual-actions">
                <a href="tel:03348441095" class="leader-sub-btn call-sub-btn" aria-label="Call Finance Secretary">
                  <Icon name="phone" size={13} />
                  <span>0334 8441095</span>
                </a>
                <a href="https://wa.me/923348441095?text=Peace%20be%20upon%20you%20Waheed-ur-Rehman%20Sahib,%20I%20am%20contacting%20regarding%20Togh%20Aman%20Committee%20finance." target="_blank" rel="noopener noreferrer" class="leader-sub-btn wa-sub-btn" aria-label="WhatsApp Finance Secretary">
                  <Icon name="whatsapp" size={13} />
                  <span>WhatsApp Desk</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
    </div>
  </section>

  <!-- Democratic Structure -->
  <section class="section structure-section">
    <div class="container">
      <div class="section-title-wrap text-center reveal-on-scroll">
        <Badge variant="green">Institutional Framework</Badge>
        <h2>Committee Structure</h2>
        <p class="section-subtitle">
          A multi-tiered structure designed for checks, balances, and community-wide representation.
        </p>
      </div>

      <div class="structure-grid">
        <div class="card structure-card reveal-on-scroll">
          <Icon name="balance" size={28} class="text-green mb-3" />
          <h4>Advisors & Legal Council</h4>
          <p>Qualified legal advisors reviewing resolutions, land issues, and institutional correspondence to guarantee complete legal compliance.</p>
        </div>

        <div class="card structure-card reveal-on-scroll delay-1">
          <Icon name="shield" size={28} class="text-green mb-3" />
          <h4>Executive Committee</h4>
          <p>Comprising the President, General Secretary, Finance Secretary, and Joint Secretaries responsible for day-to-day operations and projects.</p>
        </div>

        <div class="card structure-card reveal-on-scroll delay-2">
          <Icon name="document" size={28} class="text-green mb-3" />
          <h4>Ulama (Religious Scholars)</h4>
          <p>Respected scholars reviewing all community decisions and resolutions from the viewpoint of Shariah and moral integrity.</p>
        </div>

        <div class="card structure-card reveal-on-scroll">
          <Icon name="users" size={28} class="text-green mb-3" />
          <h4>Women's Wing</h4>
          <p>A dedicated, self-governing wing safeguarding the social, educational, and welfare rights of women and children in private trust.</p>
        </div>

        <div class="card structure-card reveal-on-scroll delay-1">
          <Icon name="users" size={28} class="text-green mb-3" />
          <h4>Youth & Overseas Affairs</h4>
          <p>Dedicated wings promoting sports tournaments, employment skills, and coordinating transparent support from overseas members.</p>
        </div>

        <div class="card structure-card reveal-on-scroll delay-2">
          <Icon name="balance" size={28} class="text-green mb-3" />
          <h4>The General Body</h4>
          <p>The supreme forum of the people with authority to approve policy, review yearly accounts, and elect or dissolve the cabinet.</p>
        </div>
      </div>

      <div class="text-center mt-12 reveal-on-scroll">
        <Button variant="primary" size="lg" href="/transparency/constitution">
          <span>Read Full Constitution & Rules</span>
          <Icon name="arrow-right" size={18} />
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(180deg, var(--color-surface-subtle) 0%, var(--color-background) 100%);
    padding: var(--space-12) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .page-title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 680px;
    margin: 0 auto;
  }

  .section-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold);
    display: block;
    margin-bottom: var(--space-2);
  }

  .lead-text {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-primary);
    font-weight: 500;
    margin-bottom: var(--space-6);
  }

  .principle-quote-box {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    background: var(--color-surface-subtle);
    border-left: 4px solid var(--color-gold);
    padding: var(--space-6);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
  }

  .principle-quote-box blockquote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--color-primary);
    line-height: var(--leading-snug);
  }

  /* Timeline */
  .timeline-container {
    position: relative;
    max-width: 760px;
    margin: var(--space-8) auto 0;
    padding-left: var(--space-8);
    border-left: 3px solid var(--color-gold);
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-8);
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: calc(-1 * var(--space-8) - 9px);
    top: 24px;
    width: 16px;
    height: 16px;
    background-color: var(--color-white);
    border: 4px solid var(--color-gold);
    border-radius: var(--radius-full);
  }

  .timeline-date {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-green);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: var(--space-1);
  }

  /* ==========================================================================
     Custodian Leadership Section (High Fidelity Redesign)
     ========================================================================== */
  .leadership-full-section {
    background: linear-gradient(180deg, #F3F7F4 0%, #FFFFFF 40%, #F5F8F6 100%);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-16) 0;
    position: relative;
  }

  .leadership-badge-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: var(--space-3);
  }

  .leadership-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(6, 77, 50, 0.08);
    color: var(--color-primary);
    padding: 4px 14px;
    border-radius: 9999px;
    font-size: 12.5px;
    font-weight: 600;
    border: 1px solid rgba(6, 77, 50, 0.15);
  }

  .leadership-section-title {
    font-size: clamp(1.85rem, 3.2vw, 2.65rem);
    font-weight: 800;
    color: var(--color-primary);
    margin: 0 auto var(--space-2);
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-align: center;
  }

  .urdu-leadership-title {
    display: block;
    text-align: center;
    font-size: clamp(1.15rem, 2.2vw, 1.55rem);
    font-weight: 700;
    color: var(--color-green);
    line-height: 1.7;
    margin: 0 auto var(--space-4);
  }

  .leaders-profile-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 1280px;
    margin: 0 auto;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .leaders-profile-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .leaders-profile-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }

  .leader-profile-card {
    background: #FFFFFF;
    border: 1px solid rgba(6, 77, 50, 0.12);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: 0 4px 20px rgba(6, 77, 50, 0.05);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .leader-profile-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 36px -4px rgba(6, 77, 50, 0.12);
    border-color: var(--color-gold);
  }

  .leader-profile-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-gold));
    opacity: 0.8;
  }

  .leader-card-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: var(--space-3);
  }

  .leader-role-urdu {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-green);
  }

  .leader-photo-wrap {
    height: 270px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
    margin-bottom: var(--space-4);
    background-color: var(--color-surface-subtle);
    border: 2px solid rgba(6, 77, 50, 0.08);
  }

  .profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.4s ease;
  }

  .leader-profile-card:hover .profile-img {
    transform: scale(1.05);
  }

  .photo-overlay-tag {
    position: absolute;
    bottom: 8px;
    left: 8px;
    right: 8px;
    background: rgba(6, 77, 50, 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .profile-content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .leader-name-block {
    display: flex;
    flex-direction: column;
    margin-bottom: 2px;
  }

  .leader-name {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-primary);
    margin: 0;
    line-height: 1.25;
  }

  .leader-name-urdu {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-green);
    margin-top: 1px;
  }

  .profile-tenure {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
