  .text-green { color: var(--color-green); }
</style>

<script>
  function setupWorkHeroInteractive() {
    const hero = document.getElementById('work-hero');
    if (!hero) return;

    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      hero.style.setProperty('--mouse-x', `${x}px`);
      hero.style.setProperty('--mouse-y', `${y}px`);
    });

    hero.addEventListener('mouseleave', () => {
      hero.style.setProperty('--mouse-x', '50%');
      hero.style.setProperty('--mouse-y', '50%');
    });
  }

  setupWorkHeroInteractive();
  document.addEventListener('astro:page-load', setupWorkHeroInteractive);
</script>
